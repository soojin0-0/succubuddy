<script>
function filterNotice() {
  const input = document.getElementById("noticeSearchInput").value.toLowerCase();
  const rows = document.querySelectorAll(".FAQ tr");

  for (let i = 0; i < rows.length; i += 2) {
    const titleRow = rows[i];
    const answerRow = rows[i + 1];
    const category = titleRow.children[0].textContent.toLowerCase();
    const subject = titleRow.children[1].textContent.toLowerCase();

    if (category.includes(input) || subject.includes(input)) {
      titleRow.style.display = "";
      answerRow.style.display = "none"; // 검색시 기본은 닫힘
    } else {
      titleRow.style.display = "none";
      answerRow.style.display = "none";
    }
  }
}

// 엔터 & 실시간 검색 처리
document.addEventListener("DOMContentLoaded", function () {
  const input = document.getElementById("noticeSearchInput");
  input.addEventListener("keyup", function (e) {
    filterNotice();
    if (e.key === "Enter") {
      e.preventDefault();
      filterNotice();
    }
  });
});
</script>

</body>
</html>