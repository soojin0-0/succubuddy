<%@ page contentType="text/html;charset=euc-kr" session="true" %>
<%@ page import="java.sql.*, java.util.*, java.util.HashMap" %>
<%
    // 세션에서 로그인 정보 확인
    String userId = (String) session.getAttribute("sid");  // "sid"가 세션에 저장되어 있는지 확인
    
    if (userId == null) {
%>
    <script>
        alert("로그인이 필요합니다!");
        location.href = "login.jsp"; // 로그인 페이지로 리디렉션
    </script>
<%
        return; // 로그인되지 않으면 나머지 코드 실행하지 않음
    }

    String DB_URL = "jdbc:mysql://localhost:3306/succu";
    String DB_ID = "multi";
    String DB_PASSWORD = "abcd";

    Connection conn = null;
    PreparedStatement pstmt = null;
    ResultSet rs = null;

    // 장바구니 추가 관련 데이터 받기
    String productId = request.getParameter("product_id");
    String purchaseQuantityStr = request.getParameter("purchaseQuantity");
	String potIdStr = request.getParameter("pot_id");    // <<== 추가
    int purchaseQuantity = 1; // 기본값 설정
	
	Integer potId = null;
	if (potIdStr != null && !potIdStr.trim().equals("")) {
		try { potId = Integer.parseInt(potIdStr.trim()); } catch(Exception e){ potId = null; }
	}
    if (purchaseQuantityStr != null && !purchaseQuantityStr.isEmpty()) {
        try {
            purchaseQuantity = Integer.parseInt(purchaseQuantityStr);
        } catch (NumberFormatException e) {
            purchaseQuantity = 1; // 잘못된 값이 전달된 경우 기본값 1로 설정
        }
    }

    List<Map<String, String>> cartItems = new ArrayList<>();
	List<Map<String, String>> potList = new ArrayList<>();
	Map<String, List<Map<String, String>>> productPotMap = new HashMap<>();

    int totalPrice = 0;
    int totalDiscount = 0;
    int totalShippingFee = 0;

    try {
        Class.forName("org.gjt.mm.mysql.Driver");
        conn = DriverManager.getConnection(DB_URL, DB_ID, DB_PASSWORD);

        //  장바구니 추가 로직 추가
        if (productId != null) {
            String checkSql = "SELECT quantity FROM cart WHERE user_id = ? AND product_id = ?";
            PreparedStatement checkPstmt = conn.prepareStatement(checkSql);
            checkPstmt.setString(1, userId);
            checkPstmt.setString(2, productId);
            ResultSet checkRs = checkPstmt.executeQuery();

            if (checkRs.next()) {
				// 이미 담긴 상품 → 수량 업데이트 (pot_id도 업데이트 해도 됨)
				// 원한다면 pot_id, quantity 둘 다 update 가능
				String updateSql = "UPDATE cart SET quantity = quantity + ?, pot_id = ? WHERE user_id = ? AND product_id = ?";
				PreparedStatement updatePstmt = conn.prepareStatement(updateSql);
				updatePstmt.setInt(1, purchaseQuantity);
				if (potId != null) updatePstmt.setInt(2, potId);
				else updatePstmt.setNull(2, java.sql.Types.INTEGER);
				updatePstmt.setString(3, userId);
				updatePstmt.setString(4, productId);
				updatePstmt.executeUpdate();
				updatePstmt.close();
			} else {
				// 새로 담는 경우 → INSERT (pot_id 포함)
				String insertSql = "INSERT INTO cart (user_id, product_id, quantity, pot_id) VALUES (?, ?, ?, ?)";
				PreparedStatement insertPstmt = conn.prepareStatement(insertSql);
				insertPstmt.setString(1, userId);
				insertPstmt.setString(2, productId);
				insertPstmt.setInt(3, purchaseQuantity);
				if (potId != null) insertPstmt.setInt(4, potId);
				else insertPstmt.setNull(4, java.sql.Types.INTEGER);
				insertPstmt.executeUpdate();
				insertPstmt.close();
			}

			checkRs.close();
			checkPstmt.close();
		}

        //  장바구니 목록 조회 (상품 정보 불러오기)
       //  공백 문제 해결을 위해 TRIM() 및 REPLACE() 추가
       String sql = "SELECT REPLACE(TRIM(c.product_id), ' ', '') AS product_id, " +
             "p.name, p.price, c.quantity, c.pot_id, po.pot_name, " +
             "IFNULL(po.extra_price, 0) AS pot_price " +   //  화분 추가금액까지 가져오기
             "FROM cart c " +
             "JOIN product p ON c.product_id = p.product_id " +
             "LEFT JOIN pot po ON c.pot_id = po.pot_id " +
             "WHERE c.user_id = ? " +
             "ORDER BY c.quantity DESC";

        pstmt = conn.prepareStatement(sql);
        pstmt.setString(1, userId);
        rs = pstmt.executeQuery();

        while (rs.next()) {
			Map<String, String> item = new HashMap<>();
			item.put("product_id", rs.getString("product_id"));
			item.put("name", rs.getString("name"));
			item.put("price", rs.getString("price"));
			item.put("pot_price", rs.getString("pot_price"));
			item.put("quantity", rs.getString("quantity"));
			item.put("pot_id", rs.getString("pot_id"));       // 꼭 추가!
			item.put("pot_name", rs.getString("pot_name"));   // 이미 있음

			int productPrice = Integer.parseInt(item.get("price"));
			int potPrice = (item.get("pot_price") != null) ? Integer.parseInt(item.get("pot_price")) : 0;
			int quantity = Integer.parseInt(item.get("quantity"));
			int itemTotal = (productPrice + potPrice) * quantity;
			totalPrice += itemTotal;

			item.put("item_total", String.valueOf(itemTotal));
			cartItems.add(item);
		}
		
		for (Map<String, String> item : cartItems) {
			// 장바구니 상품 반복문 안에 넣으세요
			String pId = item.get("product_id");
			String name = item.get("name");

			// 예외 매핑: 초보자 상품명 Map
			Map<String, String> beginnerMap = new HashMap<>();
			beginnerMap.put("블루빈스", "초보자");
			beginnerMap.put("백운각", "초보자");
			beginnerMap.put("재옥", "초보자");
			beginnerMap.put("브론즈", "초보자");
			beginnerMap.put("성미인", "초보자");
			beginnerMap.put("하월시아 옵투사", "초보자");
			beginnerMap.put("용신목", "초보자");
			beginnerMap.put("은세무리아", "초보자");
			beginnerMap.put("아가베 아테누아타", "초보자");
			// 아래처럼 필요한 상품명 추가 가능

			String level;
			if (beginnerMap.containsKey(name)) {
				level = beginnerMap.get(name); // 강제로 초보자
			} else {
				level = name.contains("초보") ? "초보자" : "중상급자";
			}

			// 사이즈 분기는 product_id 앞글자
			String size = pId.startsWith("s") ? "소"
					   : pId.startsWith("m") ? "중"
					   :                        "대";

			// 이제 정확히 조건 적용
			String potSql = "SELECT pot_id, pot_name, extra_price, image_name FROM pot WHERE level = ? AND size = ?";
			PreparedStatement potPstmt = conn.prepareStatement(potSql);
			potPstmt.setString(1, level);
			potPstmt.setString(2, size);
			ResultSet potRs = potPstmt.executeQuery();

			List<Map<String, String>> pots = new ArrayList<>();
			while (potRs.next()) {
				Map<String, String> pot = new HashMap<>();
				pot.put("pot_id",      potRs.getString("pot_id"));
				pot.put("pot_name",    potRs.getString("pot_name"));
				pot.put("extra_price", potRs.getString("extra_price"));
				pot.put("image_name",  potRs.getString("image_name"));
				pots.add(pot);
			}
			potRs.close();
			potPstmt.close();

			productPotMap.put(pId, pots);

	}

		
    } catch (Exception e) {
        out.println("<script>alert('장바구니를 불러오는 중 오류 발생: " + e.getMessage() + "');</script>");
    } finally {
        if (rs != null) try { rs.close(); } catch (SQLException ignored) {}
        if (pstmt != null) try { pstmt.close(); } catch (SQLException ignored) {}
        if (conn != null) try { conn.close(); } catch (SQLException ignored) {}
    }
%>
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="euc-kr">
    <title>장바구니</title>
    <style>
		@font-face {
            font-family: 'GmarketSansTTFMedium';
            src: url('fonts/GmarketSansTTFMedium.ttf') format('truetype');
        }

        @font-face {
            font-family: 'GmarketSansTTFBold';
            src: url('fonts/GmarketSansTTFBold.ttf') format('truetype');
        }

        @font-face {
            font-family: 'GmarketSansTTFLight';
            src: url('fonts/GmarketSansTTFLight.ttf') format('truetype');
        }
		@font-face {
			font-family: 'RixInooAriDuriPro';  /* 폰트 이름 지정 */
			src: url('fonts/RixInooAriDuri_Pro Regular.otf')  format('opentype'); /* OTF 파일은 'opentype' 지정 */
			font-weight: normal;
			font-style: normal;
		}
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            margin: 0;
            width: 1920px;
            overflow-x: hidden;
        }
        
        .container {
            width: 1100px;
            margin: 60px 200px;
        }
		        .navbar {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 82px 150px;
			width: 1920px;
			margin: 0 auto;
			margin-bottom: 20px; /* 네비게이션 아래 여백 추가 */
		}

		.logo {
			display: block;
			width: 300px;
			height: 56px;
			margin-left: -30px;
			margin-right: 20px;
		}

		.nav-menu {
			display: flex;
			align-items: center;
			gap: 80px;
		}

		.nav-menu a {
			text-decoration: none;
			color: black;
			font-size: 26px;
			font-weight: 550;
			font-family: 'GmarketSansTTFMedium';
			margin-top: 12px;
		}

		.nav-icons {
			display: flex;
			align-items: center;
			gap: 35px; /* 아이콘 및 로그인 간격 */
			margin-top: 10px; /* 아이콘과 로그인 위치 조정 */
			margin-left: 33px;
		}

		/* 아이콘 크기 조정 */
		.nav-icons img {
			width: 40px;
			height: 40px;
		}

		/* 로그아웃 링크 스타일 */
		.nav-login {
			text-decoration: none;
			font-size: 24px;
			font-family: 'GmarketSansTTFMedium';
			color: black;
			margin-top:10px;
		}
		/*장바구니 비었을 때*/
		.empty-cart-message {
			font-size: 30px; /* 글씨 크기 조정 */
			text-align: center; /* 가로 가운데 정렬 */
			margin-top: 80px; /* 상단 여백 */
			height: 100px;
			border-bottom: 2px solid #666;  /* 장바구니 제목 아래 구분선 */
			width: 1400px;
			font-family: 'GmarketSansTTFMedium';
		}
		/* 장바구니 제목 스타일 */
		.cart-title {
			font-size: 32px;
			font-family: 'GmarketSansTTFMedium';
			margin-bottom: 20px;
			padding-bottom: 30px;
			border-bottom: 2px solid #666;  /* 장바구니 제목 아래 구분선 */
			width: 1400px;
		}
		/* 장바구니 헤더 컨테이너 */
		.cart-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 10px 0;
			font-size: 16px;
			font-family: 'GmarketSansTTFMedium';
		}
		/* 전체 컨테이너 */
		.header-container {
			display: flex;
			flex-direction: column;  /* 세로 정렬 */
			align-items: flex-start; /* 왼쪽 정렬 */
			width: 100%;
			padding-bottom: 10px;
		}
		/* 장바구니 제목 */
		.header-title {
			font-size: 30px;
			font-family: 'GmarketSansTTFMedium';
			margin-bottom: 5px;
		}
		/*불필요한 border-bottom 제거 */
		.header-options {
			display: flex;
			justify-content: space-between;
			align-items: center;
			width: 1400px;
			padding: 25px 0px;
		}
		/* 전체 선택 체크박스 스타일 */
		.select-all-container {
			display: flex;
			align-items: center;
			gap: 20px; /* 체크박스와 글씨 사이 간격 */
			font-size: 18px;
			font-family: 'GmarketSansTTFMedium';
			margin-left: 15px;
		}

		/* 체크박스 스타일 */
		.select-all-container input[type="checkbox"] {
			width: 35px;
			height: 35px;
			appearance: none; /* 기본 스타일 제거 */
			border: 2px solid #ddd;
			background-color: #f5f5f5;
			cursor: pointer;
			border-radius: 3px;
			display: flex;
			align-items: center;
			justify-content: center;
			position: relative;
		}

		/* 체크된 상태일 때 */
		.select-all-container input[type="checkbox"]:checked {
			background-color: #ccc;
			border-color: #aaa;
		}
		/* 체크된 상태일 때 아이콘 추가 */
		.select-all-container input[type="checkbox"]::after {
			content: "\2714";
			font-size: 14px;
			color: white;
			position: absolute;
			display: none;
		}
		/* 체크박스 체크 시 체크 아이콘 표시 */
		.select-all-container input[type="checkbox"]:checked::after {
			display: block;
		}
		/* 전체선택 글씨 스타일 */
		.select-all-label {
			font-size: 24px;
			color: black;
		}

		/*선택 삭제*/
		.delete-cart-actions {
			display: flex; /* flexbox 레이아웃 */
			justify-content: flex-end; /* 버튼을 오른쪽 정렬 */
			align-items: center; /* 세로 중앙 정렬 */
			width: auto; /* 부모 요소의 너비를 100%로 설정 */
			margin-top: 10px; /* 오른쪽 여백을 추가하여 더 밀기 */
		}
		.delete-selected-btn {
			font-size: 24px;
			color: black;
			background-color: transparent; /* 배경 투명 */
			border: none; /* 테두리 제거 */
			cursor: pointer;
			font-family: 'GmarketSansTTFMedium';
			transition: color 0.3s;
			margin-right: 30px; /* 이 속성으로 버튼을 오른쪽으로 밀어냄 */
		}

		.delete-selected-btn:hover {
			color: #7ab863; /* 호버 시 글씨 색상 변경 */
		}

		.delete-selected-btn:focus {
			outline: none; /* 포커스 시 테두리 제거 */
		}
		/*카트 구분선*/
		.cart-divider {
			width: 1400px; /* 원하는 길이 설정 */
			height: 2px;
			background-color: #666;
			margin-top: 15px;
		}


		/* 장바구니 아이템 전체 */
        .cart-item {
            display: flex;
			align-items: center; /* 요소들을 수직 중앙 정렬 */
			justify-content: space-between;
			padding: 15px 0; /* 위아래 여백 추가 */
			border-bottom: 2px solid #666;
			width: 1400px;
			height: 240px;
			position: relative;
        }
        /* 이미지 정렬 */
        .cart-item img {
            width: 180px;
			height: 180px;
			object-fit: cover;
			margin-left: 20px;
			margin-top: auto;
			margin-bottom: auto;
			display: block; /* 블록 요소로 변경 */
        }

        /* 상품 정보 컨테이너 */
        .cart-info {
			display: flex;
			align-items: center;
			justify-content: flex-start;
			gap: 20px;
			width: 250px;
			height: 100%; /* 높이를 부모 요소와 동일하게 */
		}

		/* 상품명 */
		.cart-name {
			font-size: 28px;
			font-family: 'GmarketSansTTFLight';
			text-align: left;
			white-space: nowrap;
			padding-left: 20px;
			margin-top: 19px;
			flex-grow: 1; /* 너비 자동 확장 */
		}
		/* 수량 조절 버튼 */
		.cart-quantity {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 189px;
			height: 48px;
			background-color: #f5f5f5;
			border-radius: 6px;	
			margin-left: -15px;
		}
		/* - 와 + 버튼 */
		.quantity-btn {
			width: 51px;
			height: 48px;
			font-size: 20px;
			font-weight: bold;
			color: black;
			background-color: #7ab863;
			border: none;
			cursor: pointer;
		}

		.quantity-btn:first-child {
			border-top-left-radius: 6px;
			border-bottom-left-radius: 6px;
		}

		.quantity-btn:last-child {
			border-top-right-radius: 6px;
			border-bottom-right-radius: 6px;
		}

		.quantity-btn:hover {
			background-color: #5a9b47;
		}
		/* 수량 표시 */
		.quantity-display {
			width: 87px;
			height: 48px;
			text-align: center;
			font-size: 20px;
			background-color: #ffffff;
			border-top: 1px solid #ddd;
			border-bottom: 1px solid #ddd;
			line-height: 50px;
			font-family: 'GmarketSansTTFMedium';
		}
		/* 상품 앞 체크박스 스타일 */
		.product-checkbox {
			width: 35px;
			height: 35px;
			appearance: none;
			border: 2px solid #ddd;
			background-color: #f0f0f0; /* 연한 회색 */
			cursor: pointer;
			border-radius: 3px;
			display: flex;
			align-items: center;
			justify-content: center;
			position: relative;
			margin-right: 15px; /* 상품 이미지와 간격 */
			margin-left:15px;
		}

		/* 체크된 상태일 때 */
		.product-checkbox:checked {
			background-color: #ccc; /* 체크 시 더 진한 회색 */
			border-color: #aaa;
		}

		/* 체크 표시 추가 */
		.product-checkbox::after {
			content: "\2714";  /* 유니코드 체크 표시 */
			font-size: 14px;
			color: white;
			position: absolute;
			display: none;
		}

		/* 체크박스 체크 시 체크 아이콘 표시 */
		.product-checkbox:checked::after {
			display: block;
		}
		
	
		/* 구분선 */
        .divider {
            width: 2px;
			height: 165px;
			background-color: #aaa;
			margin-left: 15px;  /* 상품명과의 간격 조정 */
			margin-right: 30px; /* 다음 요소와의 간격 조정 */
        }
		/* 가격 컨테이너 */
		.cart-price-container {
			display: flex;
			align-items: center;
			justify-content: center;
			min-width: 120px; /* 가격이 일정한 위치에 있도록 최소 크기 지정 */
			margin-left: -10px;
		}
		/* 가격 */
        .cart-price {
            font-size: 22px;
            color: #7ab863;
            text-align: right;
			font-family: 'GmarketSansTTFMedium';
			white-space: nowrap; /* 텍스트가 줄바꿈 되지 않도록 */
		}
		.cart-currency {
			font-size: 22px;
			color: #7ab863;
			font-family: 'GmarketSansTTFMedium';
			vertical-align: middle; /* '원' 텍스트를 가격과 맞춰 수평 정렬 */
		}
		/* 무료배송 및 도서 */
		.cart-shipping {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center; /* 세로 중앙 정렬 */
			min-height: 120px; /* 높이를 일정하게 맞춰서 균일한 정렬 */
			margin-left: -10px;
			margin-right:10px;
			gap: 10px;
		}

		.shipping-title {
			font-size: 18px;
			font-weight: bold;
			color: black;
		}

		.shipping-note {
			font-size: 14px;
			color: #666;
		}
		/* 바로구매 & 삭제 버튼*/
		.cart-actions {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 15px;
			margin-left: -15px; /* 버튼 간격 조정 */
			margin-right: 30px;
			font-family: 'GmarketSansTTFLight';

		}
		.cart-actions button {
			width: 110px;
			height: 40px;
		}
		.buy-now-btn {
			border: 2px solid #7ab863;
			background-color: white;
			color: #7ab863;
			font-size: 16px;
			font-weight: bold;
			text-align: center;
			border-radius: 10px;
			cursor: pointer;
		}

		.delete-btn {
			border: 1px solid #666;
			background-color: white;
			color: black;
			font-size: 14px;
			text-align: center;
			border-radius: 10px;
			cursor: pointer;
		}

		.buy-now-btn:hover {
			background-color: #7ab863;
			color: white;
		}

		.delete-btn:hover {
			background-color: #ddd;
		}
		/* 전체 영역 */
		.summary-container {
			display: flex;
			justify-content: space-between;
			align-items: flex-start;
			width: 1400px;
			height: 230px;
			border-bottom: 2px solid #666;
			margin-top: 50px;
		}

		/* 왼쪽 영역 */
		.summary-left {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			width: 600px;  /* 왼쪽 영역 너비 */
			padding-right: 0px;  /* 오른쪽과 간격을 더 넓혀줍니다 */
			margin-left: 60px;
		}

		/* 각 항목 간격 조정 */
		.summary-left .summary-item {
			display: flex;
			justify-content: space-between; /* 왼쪽/오른쪽 항목 사이 간격 조정 */
			align-items: center;  /* 세로 정렬 */
			margin-bottom: 50px;  /* 항목 간 간격을 넓혀줍니다 */
			width: 600px;
		}
		/* '상품 금액' 항목은 Medium 글씨체 */
		.summary-left .summary-item .summary-label {
			font-family: 'GmarketSansTTFMedium';  /* 상품 금액만 Medium으로 설정 */
			font-size: 24px;
		}

		/* 왼쪽 항목 '원'과의 간격을 더 넓히기 위해 padding 추가 */
		.summary-left .summary-value {
			color: #333;
			font-family: 'GmarketSansTTFLight';
			padding-left: 10px;  /* '원'과의 간격을 넓히기 위해 padding 추가 */
			font-size: 24px;
		}

		/* 오른쪽 영역 */
		.summary-right {
			display: flex;
			flex-direction: column;  /* 세로 정렬 */
			align-items: flex-end;  /* 오른쪽 정렬 */
			width: 50%;
			text-align: center;  /* 오른쪽 정렬 */
			margin-right: 150px;
			margin-top:20px;
		}

		/* 총 결제 예상 금액 스타일 */
		.total-price-label {
			font-family: 'GmarketSansTTFMedium';
			font-size: 28px;
			margin-bottom: 10px;
		}

		/* 가격과 원을 감싸는 컨테이너 */
		.total-price-container {
			display: flex;
			flex-direction: row;  /* 가로로 정렬 */
			align-items: baseline;  /* 수평 정렬 */
			margin-top: 20px;
		}

		/* 가격 스타일 */
		.total-price {
			font-size: 26px;
			color: #7ab863;
			font-size:50px;
			font-family: 'GmarketSansTTFBold';
			margin-right: 10px;  /* 가격과 원 사이의 간격 */
		}

		/* 원 글씨 스타일 */
		.currency {
			font-size: 32px;
			color: #333;
			font-family: 'GmarketSansTTFLight';  /* 원 글씨체 */
		}
		/* summary 구분선 */
		.summary-divider {
			width: 2px;
			height: 210px;
			background-color: #aaa;
			margin-left: 195px;  /* 왼쪽 여백을 줄여서 오른쪽으로 이동 */
			margin-right: 10px; /* 오른쪽 여백 추가 */
		}
		/* 주문 버튼 컨테이너 */
		.order-buttons {
			display: flex;
			gap: 60px;  /* 버튼 간격 */
			margin-top: 160px;  /* 위쪽 여백 */
			margin-bottom:123px;
			justify-content: center;  /* 가로 가운데 정렬 */
			align-items: center;      /* 세로 가운데 정렬 */
			text-align: center; /* 텍스트 중앙 정렬 */
			position: relative;       /* 추가: 중앙 정렬 보정 */
			left: 175px;               /*  오른쪽으로 이동 (수치 조정 가능) */
		}

		/* 선택 주문 버튼 (초록색) */
		.select-order-btn {
			background-color: #7ab863;
			color: white;
			border: none;
			width: 220px;
			height:61px;
			font-size: 22px;
			border-radius: 8px;
			cursor: pointer;
			font-family: 'GmarketSansTTFMedium';
		}

		/* 전체 주문 버튼 (흰색 테두리) */
		.all-order-btn {
			background-color: white;
			color: #7ab863;
			border: 2px solid #7ab863;
			width: 220px;
			height:61px;
			font-size: 22px;
			border-radius: 8px;
			cursor: pointer;
			font-family: 'GmarketSansTTFMedium';
		}

		/* 버튼 호버 효과 */
		.select-order-btn:hover {
			background-color: #5a9b47;
		}

		.all-order-btn:hover {
			background-color: #7ab863;
			color: white;
		}
		/*화분 변경 */
		.cart-pot-info {
		  margin-top: 14px;
		  font-size: 18px;
		  text-align: left;
		  display: flex;
		  flex-direction: column; /* 세로 정렬 */
		  gap: 3px;
		}

		.pot-desc {
		  color: #333;
		  font-size: 16px;
		  margin-bottom: 2px;
		  font-family: 'GmarketSansTTFMedium';
		}

		.change-pot-link {
		  color: #60af46;
		  text-decoration: none;
		  cursor: pointer;
		  font-size: 15px;
		  font-family: 'GmarketSansTTFMedium';
		  margin-top: 2px;
		  display: inline-block;
		}
		/*모달*/
		.modal-overlay {
		  position: fixed;
		  top: 0;
		  left: 0;
		  width: 100%;
		  height: 100%;
		  background-color: rgba(0, 0, 0, 0.4); /* 배경 반투명 */
		  display: flex;
		  justify-content: center;
		  align-items: flex-start; /* 위쪽 정렬로 변경 */
		  padding-top: 450px; /* 위에서 어느 정도 떨어지게 */
		  z-index: 9999;
		}
		  .modal-content {
			width: 666px;
			height: 361px;
			background-color: white;
			padding: 80px;
			border-radius: 8px;
			font-family: 'GmarketSansTTFMedium';
		  }

		  .modal-content h2 {
			font-size: 30px;
			margin-bottom: 20px;
			border-bottom: 2px solid #333;
			padding-bottom: 10px;
			font-family: 'GmarketSansTTFMedium';
		  }

		  .modal-content select {
			width: 100%;
			height: 65px;
			font-size: 30px;
			margin-bottom: 30px;
			font-family: 'GmarketSansTTFLight';  /* 원 글씨체 */
			border-radius: 8px;
			padding-left: 30px;
			padding-top: 5px;
		  }

		  .modal-buttons {
			display: flex;
			margin-left: 50px;
			gap: 30px; 
		  }

		  .modal-buttons button {
			width: 40%;
			height: 45px;
			font-size: 20px;
			border: 1px solid #7ab863;
			border-radius: 6px;
			cursor: pointer;
		  }

		  .modal-buttons button:first-child {
		   font-family: 'GmarketSansTTFLight';  /* 원 글씨체 */
		   background-color: #7ab863;
			color: white;
		  }

		  .modal-buttons button:last-child {
			font-family: 'GmarketSansTTFLight';  /* 원 글씨체 */
			background-color: white;
			color: #7ab863;
		  }	
		/*푸터*/
		.footer {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 1920px;
            height: 283px;
            padding: 0 150px; /* 왼쪽과 오른쪽 패딩 조정 */
            background-color: #60af46;
        }

        .footer-left,
        .footer-right {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .footer-left {
            font-size: 50px;
            font-family: 'RixInooAriDuriPro'; /* Medium font 적용 */
            margin-left: 50px;
			color: #ffffff;
        }

        .footer-right {
            font-size: 18px;
            color: #ffffff;
            margin-left: 130px;
            font-family: 'GmarketSansTTFLight'; /* Light font 적용 */
        }

        .footer-right span {
            margin-bottom: 10px;
        }

        .footer-right a {
            text-decoration: none;
            color: #ffffff;
        }
    </style>
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script>
		 // 장바구니 수량 업데이트 함수 (AJAX 요청)
		function updateCart(productId, quantity) {
			if (quantity < 1) return; // 최소 수량 제한

			let xhr = new XMLHttpRequest();
			xhr.open("POST", "update_cart.jsp", true);
			xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");

			xhr.onreadystatechange = function () {
				if (xhr.readyState === 4 && xhr.status === 200) {
					let responseText = xhr.responseText.trim();

					if (responseText.startsWith("error")) {
						if (responseText === "error: not_logged_in") {
							alert("로그인이 필요합니다!");
							location.href = "login.jsp";
						} else {
							alert("가격 업데이트 중 오류 발생: " + responseText);
						}
					} else {
						let updatedPrice = parseInt(responseText.replace(/,/g, ''));
						updateCartUI(productId, quantity, updatedPrice);
						updateTotalPrice();
					}
				}
			};

			xhr.send("product_id=" + productId + "&quantity=" + quantity);
		}

		// UI 업데이트 함수 (상품 개별 가격 및 수량)
		function updateCartUI(productId, quantity, updatedPrice) {
			document.getElementById("quantity_" + productId).innerText = quantity; // 수량 업데이트
			document.getElementById("price_" + productId).innerText = updatedPrice.toLocaleString(); // 가격 업데이트
		}

		// 총 결제 금액 업데이트 함수
		function updateTotalPrice() {
			let totalPrice = 0;
			document.querySelectorAll(".cart-price").forEach(priceElement => {
				let price = parseInt(priceElement.innerText.replace(/,/g, '').replace("원", ""));
				if (!isNaN(price)) totalPrice += price;
			});
			document.getElementById("total-price").innerText = totalPrice.toLocaleString();
		}

		// 수량 증가 및 감소 함수
		function changeQuantity(productId, increase) {
			let quantityElement = document.getElementById("quantity_" + productId);
			let currentQuantity = parseInt(quantityElement.innerText);
			
			let newQuantity = increase ? currentQuantity + 1 : Math.max(1, currentQuantity - 1);
			
			if (newQuantity !== currentQuantity) {
				updateCart(productId, newQuantity);
			}
		}
		// 체크박스 전체 선택/해제
		document.addEventListener("DOMContentLoaded", function () {
			const selectAllCheckbox = document.getElementById("select-all");
			const productCheckboxes = document.querySelectorAll(".product-checkbox");

			selectAllCheckbox.addEventListener("change", function () {
				productCheckboxes.forEach(checkbox => {
					checkbox.checked = selectAllCheckbox.checked;
				});
			});

			productCheckboxes.forEach(checkbox => {
				checkbox.addEventListener("change", function () {
					selectAllCheckbox.checked = [...productCheckboxes].every(cb => cb.checked);
				});
			});

			updateBuyButtons();
		});

		// 선택 주문 (체크된 상품만 결제 페이지로 전달)
		function processSelectedOrder() {
			let selectedItems = [];
			let selectedQuantities = [];

			// 체크된 상품의 ID와 수량을 가져옴
			document.querySelectorAll(".product-checkbox:checked").forEach(checkbox => {
				let cartItem = checkbox.closest(".cart-item");
				let productId = checkbox.value;
				let quantity = cartItem.querySelector(".quantity-display").innerText;

				selectedItems.push(productId);
				selectedQuantities.push(quantity);
			});

			if (selectedItems.length === 0) {
				alert("주문할 상품을 선택하세요.");
				return;
			}

			// 주문 페이지로 이동 (선택된 상품들)
			let url = "shopping_order_payment.jsp?type=selected&products=" + selectedItems.join(",") + "&quantities=" + selectedQuantities.join(",");
			window.location.href = url;
		}

		// 전체 주문 (장바구니의 모든 상품을 결제 페이지로 전달)
		function processAllOrder() {
			let allItems = [];
			let allQuantities = [];

			// 모든 상품의 ID와 수량을 가져옴
			document.querySelectorAll(".product-checkbox").forEach(checkbox => {
				let cartItem = checkbox.closest(".cart-item");
				let productId = checkbox.value;
				let quantity = cartItem.querySelector(".quantity-display").innerText;

				allItems.push(productId);
				allQuantities.push(quantity);
			});

			if (allItems.length === 0) {
				alert("주문할 상품이 없습니다.");
				return;
			}

			// 주문 페이지로 이동 (장바구니 전체 상품)
			let url = "shopping_order_payment.jsp?type=all&products=" + allItems.join(",") + "&quantities=" + allQuantities.join(",");
			window.location.href = url;
		}

		// 선택 삭제 기능
		function deleteSelectedItems() {
			let selectedIds = [...document.querySelectorAll('.product-checkbox:checked')].map(cb => cb.value.trim());

			if (selectedIds.length === 0) {
				alert("삭제할 상품을 선택하세요.");
				return;
			}

			let xhr = new XMLHttpRequest();
			xhr.open("POST", "delete_cart.jsp", true);
			xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");

			xhr.onreadystatechange = function () {
				if (xhr.readyState === 4 && xhr.status === 200) {
					if (xhr.responseText.trim() === "success") {
						alert("선택한 상품이 삭제되었습니다.");
						window.location.href = "shopping_list.jsp?nocache=" + new Date().getTime();
					} else {
						alert("삭제 중 오류가 발생했습니다. 서버 응답: " + xhr.responseText);
					}
				}
			};

			xhr.send("product_ids=" + selectedIds.join(","));
		}

		// 개별 삭제 기능
		function deleteItem(productId) {
			if (!confirm("이 상품을 삭제하시겠습니까?")) return;

			let xhr = new XMLHttpRequest();
			xhr.open("POST", "delete_cart.jsp", true);
			xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");

			xhr.onreadystatechange = function () {
				if (xhr.readyState === 4 && xhr.status === 200) {
					if (xhr.responseText.trim() === "success") {
						alert("상품이 삭제되었습니다.");
						window.location.href = "shopping_list.jsp?nocache=" + new Date().getTime();
					} else {
						alert("삭제 중 오류가 발생했습니다.");
					}
				}
			};

			xhr.send("product_ids=" + productId.trim());
		}



		// 바로구매 (개별 상품 하나만 결제 페이지로 전달)
		function buyNow(button) {
			const cartItem = button.closest(".cart-item");
			const checkbox = cartItem.querySelector(".product-checkbox");
			const productId = checkbox.value; // 상품 ID 가져오기
			const quantity = cartItem.querySelector(".quantity-display").innerText; // 수량 가져오기

			// 주문 페이지로 이동 (상품 ID와 수량 전달)
			let url = "shopping_order_payment.jsp?type=single&products=" + productId + "&quantities=" + quantity;
			window.location.href = url;
		}

		 function updateBuyButtons() {
			console.log(' updateBuyButtons() 호출됨');
			// 버튼 상태 업데이트 로직 (필요에 따라 추가)
		}

	</script>

</head>
<body>
	<header class="navbar">
		<a href="main.jsp">
		<img src="images/logo.png" alt="SuccuBuddy Logo" class="logo">
		</a>
		<nav class="nav-menu">
			<a href="sub1.jsp">다육 세트</a>
			<a href="sub2.jsp">다육 단품</a>
			<a href="sub3.jsp">맞춤 다육 추천</a>
			<a href="sub4.jsp">다육 탐구 생활</a>
			<a href="sub5.jsp">고객센터</a>
		</nav>
		<div class="nav-icons">
			<a href="mypage.jsp"><img src="images/Person.png" alt="사용자"></a>
			<a href="shopping_list.jsp"><img src="images/cart.png" alt="장바구니"></a>
			<a href="logout.jsp"><img src="images/logout.png" alt="로그아웃"></a> 
		</div>
	</header>


    <div class="container">

         <!--  장바구니 헤더 (제목 + 전체 선택) -->
			<div class="header-container">
				<h2 class="cart-title">장바구니</h2>
			</div>

			<div class="header-options">
				<div class="select-all-container">
					<input type="checkbox" id="select-all">
					<label for="select-all" class="select-all-label">전체선택</label>
				</div>
				<div class="delete-cart-actions">  
					<!-- 체크박스와 함께 바로 삭제 버튼 추가 -->
					<button class="delete-selected-btn" onclick="deleteSelectedItems()">선택삭제</button>
				</div>
			</div>

		<div class="cart-divider"></div>
		<!-- 장바구니 상품 목록 시작 -->
        <div class="cart-list">
			   <% if (cartItems.isEmpty()) { %>
                <p class="empty-cart-message">장바구니가 비어 있습니다.</p>
            <% } else {
                for (Map<String, String> item : cartItems) {
					int itemPrice = Integer.parseInt(item.get("price"));
					int quantity = Integer.parseInt(item.get("quantity"));

					
            %>
                <div class="cart-item" data-product-id="<%= item.get("product_id") %>">
					
					<!-- 체크박스 추가 -->
					<input type="checkbox"  class="product-checkbox" value="<%= item.get("product_id") %>">
					<!-- 상품 이미지 -->
					<img src="images/<%= item.get("product_id") %>.JPG"
						 onerror="this.onerror=null; this.src='images/<%= item.get("product_id") %>.jpg';"
						 alt="<%= item.get("name") %>">
						
						<!-- 상품 정보 -->
						<div class="cart-info">
							<div class="cart-name">
								<%= item.get("name") %>
								<div class="cart-pot-info">
									<div class="pot-desc">
										화분 | <%= item.get("pot_name") != null ? item.get("pot_name") : "선택안함" %>
									</div>
									<span class="change-pot-link" onclick="openPotModal('<%= item.get("product_id") %>')">화분 변경</span>
								</div>
							</div>
						</div>


						<div class="divider"></div>

						<!-- 수량 조절 버튼 -->
						<div class="cart-quantity">
							<button class="quantity-btn" onclick="changeQuantity('<%= item.get("product_id") %>', false)">-</button>
							<span class="quantity-display" id="quantity_<%= item.get("product_id") %>"><%= item.get("quantity") %></span>
							<button class="quantity-btn" onclick="changeQuantity('<%= item.get("product_id") %>', true)">+</button>
						</div>


						<div class="divider"></div>

						<!-- 가격 표시 -->
						<div class="cart-price-container">
							<p class="cart-price" id="price_<%= item.get("product_id") %>" data-price="<%= item.get("item_total") %>">
								<%= String.format("%,d", Integer.parseInt(item.get("item_total"))) %>
							</p>

							<span class="cart-currency" id="currency_<%= item.get("product_id") %>">원</span>
						</div>

						<div class="divider"></div>		

						 <!-- 배송 및 기타 정보 -->
						<div class="cart-shipping">
							<p class="shipping-title">무료배송</p>
							<p class="shipping-note">도서·산간 제외</p>
						</div>
						
						<div class="divider"></div>	

						<!-- 삭제 및 바로구매 버튼 -->
						<div class="cart-actions">
							<!-- 바로구매 버튼 -->
							<button class="buy-now-btn" onclick="buyNow(this)">바로구매</button>

							<!-- 삭제 버튼 (개별 상품 삭제) -->
							<button class="delete-btn" onclick="deleteItem('<%= item.get("product_id") %>')">삭제</button>
						</div>
				</div>

				<!-- 화분 변경 모달: product_id 기준 -->
				 <div class="modal-overlay" id="potModal_<%=item.get("product_id")%>" style="display:none;">
					<div class="modal-content">
					  <h2>화분</h2>
					  <select class="potSelect">
						<%
						  List<Map<String,String>> pots = productPotMap.get(item.get("product_id"));
						  if (pots != null && !pots.isEmpty()) {
							for (Map<String,String> pot : pots) {
							  String optionId    = pot.get("pot_id");
							  String optionName  = pot.get("pot_name");
							  int    extraPrice  = Integer.parseInt(pot.get("extra_price"));
							  boolean selected   = optionId.equals(item.get("pot_id"));
						%>
						  <option value="<%=optionId%>" <%=selected?"selected":""%>>
							<%=optionName%> 
							
						  </option>
						<%
							}
						  } else {
						%>
						  <option value="">선택 가능한 화분이 없습니다</option>
						<%
						  }
						%>
					  </select>
					  <div class="modal-buttons">
						<button onclick="closePotModal('<%=item.get("product_id")%>')">취소</button>
						<button onclick="confirmPotSelection('<%=item.get("product_id")%>')">선택 완료</button>
					  </div>
					</div>
				  </div>
           <% 
				}}
			%>
        </div>
		
		<div class="summary-container">
            <div class="summary-left">
                <div class="summary-item">
                    <span class="summary-label">상품 금액</span>
                    <span class="summary-value"><%= String.format("%,d", totalPrice) %> 원</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">상품 할인</span>
                    <span class="summary-value"><%= String.format("%,d", totalDiscount) %> 원</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">배송비</span>
                    <span class="summary-value"><%= String.format("%,d", totalShippingFee) %> 원</span>
                </div>
            </div>
			
			<!-- Summary 구분선 추가 -->
			<div class="summary-divider"></div>

            <div class="summary-right">
				<span class="total-price-label">총 결제 예상 금액</span>
                <div class="total-price-container">
                    <span class="total-price" id="total-price">
                         <%= String.format("%,d", totalPrice) %>
                    </span>
                    <span class="currency">원</span>
                </div>
            </div>
        </div>
		<!-- 선택 주문 & 전체 주문 버튼 추가 -->
		<div class="order-buttons">
			<button class="select-order-btn" onclick="processSelectedOrder()">선택주문</button>
			<button class="all-order-btn" onclick="processAllOrder()">전체주문</button>
		</div>
	</div>
	</form>
	
	<!--푸터-->
	<footer class="footer">
		<div class="footer-left">
			<span class="brand-name">succubuddy</span>
		</div>
		<div class="footer-right">
		<br>
			<span>주소 : 충청남도 천안시 서북구 성환읍 대학로 91 | EMAIL : succubuddy@naver.com</span>
			<span>TEL : 070-022-2026 | &copy; 2025 succubuddy. All Rights Reserved.</span>
			<br>
			<span><a href="footer_policy.jsp">개인정보처리방침</a> | <a href="footer_terms.jsp">이용약관</a></span>
		</div>
	</footer>


<script>
function openPotModal(productId) {
  document.getElementById("potModal_" + productId).style.display = "flex";
}
function closePotModal(productId) {
  document.getElementById("potModal_" + productId).style.display = "none";
}
function confirmPotSelection(productId) {
  const modal = document.getElementById("potModal_" + productId);
  const select = modal.querySelector('.potSelect');
  const potId = select.value;
  const potName = select.options[select.selectedIndex].text;

  const xhr = new XMLHttpRequest();
  xhr.open("POST", "update_cart_pot.jsp", true);
  xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");
  xhr.onreadystatechange = function () {
    if (xhr.readyState === 4 && xhr.status === 200) {
      try {
        const res = JSON.parse(xhr.responseText.trim());
        if (res.status === "success") {
          // 화분명 UI 변경
          const potText = document.querySelector(".cart-item[data-product-id='" + productId + "'] .pot-desc");
          if (potText) potText.innerText = "화분 | " + potName;
          // 가격 UI 변경
          const priceTag = document.getElementById("price_" + productId);
          if (priceTag && res.item_total !== undefined) {
            priceTag.innerText = Number(res.item_total).toLocaleString();
          }
          // 총 결제 금액 업데이트 (기존 함수 사용)
          updateTotalPrice();
          modal.style.display = "none";
        } else {
          alert("화분 변경 실패");
        }
      } catch (e) {
        alert("서버 오류: " + xhr.responseText);
      }
    }
  };
  xhr.send("product_id=" + productId + "&pot_id=" + potId);
}


</script>

</body>
</html>
