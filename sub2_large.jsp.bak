    </div>
</footer>

<!-- 찜목록 ajax 처리 -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    const isLoggedIn = <%= isLoggedIn %>;
    const loginId = "<%= loginId %>";

    if (isLoggedIn) {
        const productIds = document.querySelectorAll("[id^='heart-']");
        console.log("하트 요소 수:", productIds.length);

        productIds.forEach(el => {
            const pid = el.id.replace("heart-", "");
            fetch("favorite_check.jsp?user_id=" + loginId + "&product_id=" + pid)
                .then(res => res.text())
                .then(result => {
                    console.log("productId:", pid, "서버 응답:", result);
                    if (result.trim() === "exists") {
                        el.src = "images/heartgreen.png";
                    }
                });
        });
    }
});
</script>

<script>
function toggleFavorite(userId, productId) {
    fetch("toggleFavorite.jsp?user_id=" + userId + "&product_id=" + productId)
        .then(res => res.text())
        .then(result => {
            alert(result); // ex: 찜추가완료 / 찜삭제완료
            const heartImg = document.getElementById("heart-" + productId);
            if (result.includes("추가")) {
                heartImg.src = "images/heartgreen.png";
            } else if (result.includes("삭제")) {
                heartImg.src = "images/heartnone.png";
            }
        });
}
</script>

<script>
function toggleFavorite(userId, productId) {
    const heartImg = document.getElementById("heart-" + productId);
    fetch("toggleFavorite.jsp?user_id=" + userId + "&product_id=" + productId)
        .then(res => res.text())
		.then(result => {
			result = result.trim(); // ← 앞뒤 공백 제거!

			console.log("서버 응답:", result);

			if (result === "inserted") {
				heartImg.src = "images/heartgreen.png";
				alert("찜 목록에 추가됐어요!");
			} else if (result === "deleted") {
				heartImg.src = "images/heartnone.png";
				alert("찜 목록에서 제거됐어요!");
			} else {
				alert("에러 발생: " + result); // 진짜 에러일 때만 뜸
			}
		});
}
</script>

</body>
</html>