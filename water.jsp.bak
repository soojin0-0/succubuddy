<%@ page contentType="text/html;charset=euc-kr" %>
<%@ page import="java.sql.*" %>
<%
    request.setCharacterEncoding("euc-kr");

    // 1. 파라미터 받기
    String productId = request.getParameter("product_id");

    // 2. 기본 값 설정
    String title = "";
    String description = "";
    boolean dataExists = false;

    // 3. DB 연동
    if (productId != null && !productId.trim().equals("")) {
        Connection conn = null;
        PreparedStatement pstmt = null;
        ResultSet rs = null;

        try {
            Class.forName("org.gjt.mm.mysql.Driver");
            String url = "jdbc:mysql://localhost:3306/succu";
            conn = DriverManager.getConnection(url, "multi", "abcd");

            String sql = "SELECT condition_title, condition_desc FROM product_conditions WHERE product_id = ? AND condition_type = 'water'";
            pstmt = conn.prepareStatement(sql);
            pstmt.setString(1, productId);
            rs = pstmt.executeQuery();

            if (rs.next()) {
                title = rs.getString("condition_title");
                description = rs.getString("condition_desc");
                dataExists = true;
            }
        } catch (Exception e) {
            e.printStackTrace();
        } finally {
            try { if (rs != null) rs.close(); } catch (Exception e) {}
            try { if (pstmt != null) pstmt.close(); } catch (Exception e) {}
            try { if (conn != null) conn.close(); } catch (Exception e) {}
        }
    }
%>

<html lang="ko">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=euc-kr">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>물</title>
    <style>
        @font-face {
            font-family: 'GmarketSansTTFMedium';
            src: url('fonts/GmarketSansTTFMedium.ttf') format('truetype');
        }
        @font-face {
            font-family: 'GmarketSansTTFBold';
            src: url('fonts/GmarketSansTTFBold.ttf') format('truetype');
        }
        @font-face {
            font-family: 'GmarketSansTTFLight';
            src: url('fonts/GmarketSansTTFLight.ttf') format('truetype');
        }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
        }
        img {
            width: 350px;
            height: 350px;
        }
        .img {
            float: left;
            margin-top: 25px;
            margin-right: 30px;
        }
        .content {
            width: 780px;
            height: 400px;
            float: left;
            background-color: #f5f5f5;
        }
        .content h2 {
            font-family: 'GmarketSansTTFMedium';
            font-weight: bold;
            margin-top: 50px;
            margin-bottom: 50px;
        }
        .content p {
            font-family: 'GmarketSansTTFLight';
            font-size: 20px;
            text-align: left;
            padding-left: 20px;
            padding-right: 20px;
			line-height: 1.6;
        }
        .content font {
            color: #7ab863;
        }
    </style>
</head>
<body>
    <center>
    <div class="img">
        <img src="images/water.jpg">
    </div>
	<div class="content">
    <div class="content">
		<h2><%= dataExists ? title : "정보 없음" %></h2>

		<%
			if (dataExists) {
				String[] sentences = description.split("\\.\\s*");
				String[] greenWords = {
					"건조한 환경", "과습에는 매우 약한 식물", "완전히 마른 후",
					"흙이 마른 것을 확인한 후", "몸통에 직접 닿지 않게", "통풍이 잘 되는 곳",
					"과습에 약한 편", "물을 줄 타이밍", "과습에 매우 취약한 식물",
					"미지근한 물","살짝 쭈굴" //  여기 추가
				};

				for (String sentence : sentences) {
					sentence = sentence.trim();
					if (!sentence.equals("")) {
						String processed = sentence;
						for (String green : greenWords) {
							processed = processed.replace(green, "<font color='#7ab863'>" + green + "</font>");
						}
						out.println("<p>" + processed + ".</p>");
					}
				}
			} else {
		%>
			<p>해당 상품의 물 정보가 등록되어 있지 않습니다.</p>
		<%
			}
		%>
	</div>
    </center>
</body>
</html>
