<%@ page contentType="text/html;charset=euc-kr" %>
<%@ page import="java.sql.*, java.net.URLEncoder" %>

<%
    request.setCharacterEncoding("euc-kr");

    // 세션에서 userId 가져오기
    String userId = (String) session.getAttribute("sid");
    if (userId == null) {
        response.sendRedirect("login.jsp");
        return;
    }

    // 현재 페이지 번호
    int currentPage = 1;
    String pageParam = request.getParameter("page");
    if (pageParam != null && pageParam.matches("\\d+")) {
        currentPage = Integer.parseInt(pageParam);
    }

    // 검색어 파라미터 처리
    String keyword = request.getParameter("keyword");
    boolean hasKeyword = (keyword != null && !keyword.trim().equals(""));

    // 페이징 설정
    int inquiriesPerPage = 4;
    int totalInquiries = 0;
    int totalPages = 0;

    Connection conInquiry = null;
    PreparedStatement pstmt = null;
    PreparedStatement pstmtInquiry = null;
    ResultSet rs = null;
    ResultSet rsInquiry = null;

    try {
        // DB 연결
        String DB_URL = "jdbc:mysql://localhost:3306/succu";
        String DB_ID = "multi";
        String DB_PASSWORD = "abcd";

        Class.forName("org.gjt.mm.mysql.Driver");
        conInquiry = DriverManager.getConnection(DB_URL, DB_ID, DB_PASSWORD);

        // 총 문의 수 조회 (검색 포함)
        String countSql = hasKeyword ?
            "SELECT COUNT(*) FROM inquiry WHERE inquiry_subject LIKE ?" :
            "SELECT COUNT(*) FROM inquiry";
        pstmt = conInquiry.prepareStatement(countSql);
        if (hasKeyword) {
            pstmt.setString(1, "%" + keyword + "%");
        }
        rs = pstmt.executeQuery();
        if (rs.next()) {
            totalInquiries = rs.getInt(1);
            totalPages = (int) Math.ceil((double) totalInquiries / inquiriesPerPage);
        }
        rs.close();
        pstmt.close();

        // 목록 조회 SQL
        int start = (currentPage - 1) * inquiriesPerPage;
        String listSql = hasKeyword ?
            "SELECT inquiry_id, inquiry_ymd, inquiry_subject, '답변대기' AS inquiry_status FROM inquiry WHERE inquiry_subject LIKE ? ORDER BY inquiry_ymd DESC LIMIT ?, ?" :
            "SELECT inquiry_id, inquiry_ymd, inquiry_subject, '답변대기' AS inquiry_status FROM inquiry ORDER BY inquiry_ymd DESC LIMIT ?, ?";

        pstmt = conInquiry.prepareStatement(listSql);
        if (hasKeyword) {
            pstmt.setString(1, "%" + keyword + "%");
            pstmt.setInt(2, start);
            pstmt.setInt(3, inquiriesPerPage);
        } else {
            pstmt.setInt(1, start);
            pstmt.setInt(2, inquiriesPerPage);
        }

        rsInquiry = pstmt.executeQuery();
%>

<!DOCTYPE html>
