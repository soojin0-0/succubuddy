/* 고객센터 */
.title {
	font-size: 34px;
	margin-bottom: 80px;
	font-family: 'GmarketSansTTFMedium';
	margin-top: 150px;
}

/* 탭메뉴 */
.tab-menu {
	display: flex;              /* 가로로 나열하기 위해 Flex 사용 */
	border: none;
	width: 1100px;
	height: 78px;
	border-radius: 8px;
	overflow: hidden;
	font-family: 'GmarketSansTTFMedium';
}

.tab {
	flex: 1;                   /* 공간 균등 분할 */
	display: flex;               /* Flexbox 사용 */
	align-items: center;         /* 세로 중앙 정렬 */
	justify-content: center;     /* 가로 중앙 정렬 */
	padding: 10px 0;
	border-right: 2px solid #000;
	box-sizing: border-box;
	background-color: #f5f5f5;
	font-size: 20px;
	cursor: pointer;
}

.tab:last-child {
	border-right: none;        /* 마지막 탭은 테두리 제거 */
}

.tab.active {
	background-color: #7ab863;
	color: #fff;
}
/* 검색창 */
.search {
	position: relative;
	width: 600px;
}

.search input{
	width: 100%;
	height: 74px;
	border: 1px solid #000;
	border-radius: 8px;
	margin-top: 60px;
	padding-right: 55px;
	padding-left: 15px;
	font-size: 18px;
	box-sizing: border-box;
	font-family: 'GmarketSansTTFLight';
}

.search img {
	position: absolute;
	right: 17px;
	top: 73%;
	transform: translateY(-50%);
	cursor: pointer;
}
      .point {
         font-weight: bold;
         font-size: 50px;
         margin-bottom: 60px;
         font-family: 'GmarketSansTTFMedium';
      }

      /* 조회 폼 */
      .container {
            width: 1100px;
            display: flex;
            align-items: center;
            border: 1px solid #ddd;
            border-radius: 10px;
            overflow: hidden;
        }
        .content {
            flex-grow: 1;
            padding: 20px;
        }
        .options {
            display: flex;
            gap: 10px;
            justify-content: flex-start;
            margin-bottom: 20px;
        }
        .option-btn {
         width: 140px;
         height: 40px;
         font-size: 18px;
            border: none;
            border-radius: 5px;
            background-color: #f2f2f2;
            cursor: pointer;
            transition: background-color 0.3s ease, color 0.3s ease;
         margin-right: 20px;
         font-family: 'GmarketSansTTFLight';
        }
      .date-range span {
         font-family: 'GmarketSansTTFLight';
      }
        .option-btn.active {
            background-color: #7ab863;
            color: white;
        }
        .date-range {
            display: flex;
            gap: 20px;
         align-items: center;
        }
      .date-group {
            display: flex;
            align-items: center;
            gap: 5px;
         font-size: 18px;
        }
      #yearStart, #yearEnd {
         width: 90px;
         height: 40px;
         font-family: 'GmarketSansTTFLight';
      }
      #monthStart, #monthEnd {
         width: 70px;
         height: 40px;
         font-family: 'GmarketSansTTFLight';
      }
        select {
            padding: 10px;
            border: none;
			background-color: #f2f2f2;
            border-radius: 5px;
			font-size: 18px;
        }
        .query-btn {
            width: 200px;
            height: 220px;
            background-color: #7ab863;
            color: white;
            border: none;
            font-size: 24px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            border-top-right-radius: 10px;
            border-bottom-right-radius: 10px;
			font-family: 'GmarketSansTTFMedium';
        }

		/* 문의 */
		.detail {
			width: 1100px;
			margin-top: 50px;
			margin-bottom: 50px;
		}

		.detail table {
			width: 1100px;
			border-collapse: collapse; /* 테두리 겹침 방지 */
			text-align: left;
		}
		.detail td:nth-child(1) {
			width: 250px;
			padding-top: 40px;
			padding-bottom: 40px;
			padding-left: 5px;
		}
		.detail td:nth-child(3) {
			text-align: center;
		}

		.top {
			border-bottom: 2px solid #000;
			font-family: 'GmarketSansTTFMedium';
			font-size: 24px;
		}
		
		.contents {
			border-bottom: 1px solid #000;
			font-family: 'GmarketSansTTFLight';
			font-size: 20px;
		}
		.detail table td:last-child {
			width: 160px;
			padding-top: 40px;
			padding-bottom: 40px;
		}
		.detail table td:nth-child(2) {
			width: 780px;
			height: 100px;
			max-width: 780px; /* 최대 너비 설정 */
			overflow: hidden;
			white-space: nowrap;
			text-overflow: ellipsis;
			padding-left: 25px;
		}
		/* 페이지네이션 */
        .pagination {
            display: flex;
            justify-content: center;
			text-align: center;
            gap: 10px;
			font-size: 24px;
			font-family: 'GmarketSansTTFLight';
        }

        .pagination a {
            padding: 8px 15px;
            color: black;
            font-size: 20px;
			margin-bottom: 109px;

			display: inline-block;
			width: 40px;
			height: 40px;
			line-height: 26px;
			text-align: center;
			border-radius: 50%;
			transition: 0.3s ease-in-out; /* 부드러운 효과 */
        }
		.pagination a.active {
			font-weight: bold;
			background-color: #7ab863;
			color: white;
			border: 1px solid #7ab863;
		}

		/* 이전, 다음 버튼 */
		.pagination a:hover {
			background-color: #ddd;
			border-color: #999;
			transform: scale(1.1);
		}
		.pagination a.disabled {
			pointer-events: none;
			color: #ccc;
			border: none;
		}
.write {
  width: 1100px;
  margin: 0 auto;
  text-align: right; /* 버튼을 오른쪽으로 */
}

/* 글쓰기 버튼 디자인 */
.write-btn {
  background-color: #7ab863;
  color: white;
  border: none;
  padding: 10px 24px;
  font-size: 30px;
  font-family: 'GmarketSansTTFBold';
  width: 200px;
  height: 80px;
  border-radius: 43px;
  cursor: pointer;
  transition: background-color 0.2s;
}

.write-btn:hover {
  background-color: #6FA553;
}
</style>
</head>
<body>
