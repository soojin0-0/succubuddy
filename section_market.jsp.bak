<%@ page contentType="text/html; charset=euc-kr" pageEncoding="euc-kr" %>
<%@ page import="java.sql.*, java.util.*" %>
<%
request.setCharacterEncoding("euc-kr");
String loginId = (String) session.getAttribute("sid");

int curPage = 1;
String pageParam = request.getParameter("page");

int limit = 6;
int totalCount = 0;
int totalPages = 1;
double userLatitude = 0.0;
double userLongitude = 0.0;
List<Map<String, String>> markerList = new ArrayList<>();
Map<String, List<Map<String, String>>> groupedMarkers = new HashMap<>();

Connection conn = null;
PreparedStatement pstmt = null;
ResultSet rs = null;

try {
    Class.forName("org.gjt.mm.mysql.Driver");
    conn = DriverManager.getConnection("jdbc:mysql://localhost:3306/succu", "multi", "abcd");

    if (loginId != null && !loginId.equals("")) {
        pstmt = conn.prepareStatement("SELECT address, latitude, longitude FROM user WHERE user_id = ?");
        pstmt.setString(1, loginId);
        rs = pstmt.executeQuery();
        if (rs.next()) {
            userLatitude = rs.getDouble("latitude");
            userLongitude = rs.getDouble("longitude");
        }
        rs.close(); pstmt.close();

        if (request.getParameter("page") != null) {
            curPage = Integer.parseInt(request.getParameter("page"));
        }
        int offset = (curPage - 1) * limit;

        // 마커용 데이터 제한된 범위만 조회
        pstmt = conn.prepareStatement(
            "SELECT w.diary_id, w.title, w.status, w.user_id, u.address FROM sub4_write w " +
            "JOIN user u ON w.user_id = u.user_id WHERE w.category = '나눔창고' " +
            "AND (6371 * ACOS(COS(RADIANS(?)) * COS(RADIANS(u.latitude)) * " +
            "COS(RADIANS(u.longitude) - RADIANS(?)) + SIN(RADIANS(?)) * SIN(RADIANS(u.latitude)))) <= 10 " +
            "ORDER BY w.reg_date DESC LIMIT ? OFFSET ?"
        );
        pstmt.setDouble(1, userLatitude);
        pstmt.setDouble(2, userLongitude);
        pstmt.setDouble(3, userLatitude);
        pstmt.setInt(4, limit);
        pstmt.setInt(5, offset);
        rs = pstmt.executeQuery();
        while (rs.next()) {
            String status = rs.getString("status");
            String writer = rs.getString("user_id");
            if (!"나눔완료".equals(status) && !loginId.equals(writer)) {
                Map<String, String> map = new HashMap<>();
                map.put("diaryId", rs.getString("diary_id"));
                map.put("title", rs.getString("title"));
                String fullAddress = rs.getString("address");
                String trimmedAddress = fullAddress;
                if (fullAddress != null && fullAddress.contains(",")) {
                    String[] parts = fullAddress.split(",");
                    if (parts.length > 1) trimmedAddress = parts[1].trim();
                }
                map.put("address", trimmedAddress);
                map.put("writer", writer);
                map.put("status", status);
                markerList.add(map);
            }
        }
        rs.close(); pstmt.close();
    }

    StringBuilder jsDebug = new StringBuilder();
    jsDebug.append("<script>console.log(\"마커용 데이터 수: ").append(markerList.size()).append("\");\n");
    for (Map<String, String> m : markerList) {
        jsDebug.append("console.log(\"[").append(m.get("title")).append("] 주소: ").append(m.get("address")).append("\");\n");
    }
    jsDebug.append("</script>");
    out.println(jsDebug.toString());

    if (request.getParameter("page") != null) {
        curPage = Integer.parseInt(request.getParameter("page"));
    }
    int offset = (curPage - 1) * limit;

    pstmt = conn.prepareStatement("SELECT COUNT(*) FROM sub4_write w JOIN user u ON w.user_id = u.user_id WHERE w.category = '나눔창고'");
    rs = pstmt.executeQuery();
    if (rs.next()) totalCount = rs.getInt(1);
    rs.close(); pstmt.close();

    totalPages = (int)Math.ceil(totalCount / (double)limit);

    pstmt = conn.prepareStatement(
        "SELECT w.diary_id, w.title, w.image_name, w.status, w.user_id, u.address, " +
        "(6371 * ACOS(COS(RADIANS(?)) * COS(RADIANS(u.latitude)) * " +
        "COS(RADIANS(u.longitude) - RADIANS(?)) + SIN(RADIANS(?)) * SIN(RADIANS(u.latitude)))) AS distance_km " +
        "FROM sub4_write w JOIN user u ON w.user_id = u.user_id WHERE w.category = '나눔창고' " +
        "HAVING distance_km <= 10 ORDER BY w.reg_date DESC LIMIT ? OFFSET ?"
    );
    pstmt.setDouble(1, userLatitude);
    pstmt.setDouble(2, userLongitude);
    pstmt.setDouble(3, userLatitude);
    pstmt.setInt(4, limit);
    pstmt.setInt(5, offset);
    rs = pstmt.executeQuery();
%>
<html>
<head>
  <title>나눔창고</title>
  <style>
    @font-face {
      font-family: 'GmarketSansTTFMedium';
      src: url('fonts/GmarketSansTTFMedium.ttf') format('truetype');
    }

    @font-face {
      font-family: 'GmarketSansTTFBold';
      src: url('fonts/GmarketSansTTFBold.ttf') format('truetype');
    }

    @font-face {
      font-family: 'GmarketSansTTFLight';
      src: url('fonts/GmarketSansTTFLight.ttf') format('truetype');
    }

    @font-face {
      font-family: 'RixInooAriDuriPro';
      src: url('fonts/RixInooAriDuri_Pro Regular.otf') format('opentype');
      font-weight: normal;
      font-style: normal;
    }

    #map {
      width: 1405px;
      height: 500px;
      margin-bottom: 40px;
      background-color: #eee;
    }
    .content {
      width: 1405px;
      display: flex;
      flex-wrap: wrap;
      gap: 40px;
      justify-content: flex-start;
    }
    a.content-link {
      display: block;
      text-decoration: none;
      color: inherit;
      height: 500px;
    }
    .content-detail {
      width: 440px;
      height: 500px;
      border-radius: 30px;
      background-color: #eef4ea;
      display: flex;
      flex-direction: column;
      align-items: center;
      overflow: hidden;
    }
    .content-img {
      width: 390px;
      aspect-ratio: 4 / 3;
      background-color: #fff;
      border-radius: 30px;
      margin-top: 20px;
      overflow: hidden;
    }
    .content-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
	.img-overlay {
	  position: absolute;
	  top: 0;
	  left: 0;
	  width: 100%;
	  height: 100%;
	  background-color: rgba(0, 0, 0, 0.5); /* 반투명 검정 */
	  display: flex;
	  justify-content: center;
	  align-items: center;
	  color: white;
	  font-family: 'GmarketSansTTFBold';
	  font-size: 30px;
	}
	.img-wrapper {
	  position: relative;
	  width: 100%;
	  height: 100%;
	}

    .content-subject {
      font-family: 'GmarketSansTTFMedium';
      font-size: 38px;
      text-align: center;
      padding-top: 30px;
    }
    .bottom-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 1405px;
      margin-top: 40px;
      margin-bottom: 80px;
    }
    .pagination {
      width: 250px;
      height: 80px;
      background-color: #f2f7ef;
      border-radius: 43px;
      display: flex;
      gap: 15px;
      justify-content: center;
      align-items: center;
    }
    .page-btn {
      background: none;
      border: none;
      font-size: 30px;
      font-family: 'GmarketSansTTFMedium';
      color: #333;
      cursor: pointer;
      border-radius: 8px;
      width: 60px;
      height: 60px;
    }
    .page-btn.active {
      background-color: #4caf50;
      color: white;
    }
    .page-btn:hover:not(.active) {
      background-color: #e0eed9;
    }
    .page-btn.disabled {
      pointer-events: none;
      opacity: 0.4;
    }
	.write-button {
	  width: 1405px;
	  margin-top: 40px;
	}

	.write-button button {
	  width: 243px;
	  height: 100px;
	  border-radius: 43px;
	  color: #fff;
	  background-color: #60af46;
	  font-size: 40px;
	  float: right;
	  border: none;
	  font-family: 'GmarketSansTTFBold';
	  cursor: pointer;
	}

  </style>
</head>
<body>
<center>
<div id="map"></div>
<div class="content">
<div style="text-align: right; font-size: 24px; font-family: 'GmarketSansTTFLight'; width: 100%;">반경 10km 이내 이웃들이 올린 나눔 게시물이에요.</div>
<%
    while (rs.next()) {
        int diaryId = rs.getInt("diary_id");
        String title = rs.getString("title");
        String imgName = rs.getString("image_name");
        String status = rs.getString("status");
        String writerId = rs.getString("user_id");
        String address = rs.getString("address");
        String roadAddress = "";

        if (address != null && address.contains(",")) {
            String[] parts = address.split(",");
            if (parts.length > 1) roadAddress = parts[1];
        }

        Map<String, String> post = new HashMap<>();
        post.put("title", title);
        post.put("diaryId", String.valueOf(diaryId));
        post.put("status", status);
        post.put("writer", writerId);

        if (!groupedMarkers.containsKey(roadAddress)) {
			groupedMarkers.put(roadAddress, new ArrayList<>());
		}

		if (!"나눔완료".equals(status)) {
			groupedMarkers.get(roadAddress).add(post);
		}
%>
<a href="sub4_text.jsp?diary_id=<%= diaryId %>&category=나눔창고" class="content-link">
  <div class="content-detail">
    <div class="content-img">
      <div class="img-wrapper">
        <% if (imgName != null && !imgName.equals("")) { %>
          <img src="<%= request.getContextPath() %>/uploads/<%= imgName %>" alt="이미지">
        <% } else { %>
          <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size: 30px; color:#aaa;">이미지 없음</div>
        <% } %>

        <% if ("나눔완료".equals(status)) { %>
          <div class="img-overlay">나눔완료</div>
        <% } %>
      </div>
    </div>
    <div class="content-subject">
	  <div style="width: 390px; height: 46px; line-height: 46px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center;">
		<%= title %>
	  </div>
      <div style="font-size: 20px; margin-top: 10px; color: #666; padding-top: 20px;"><%= roadAddress %></div>
      <% if (loginId.equals(writerId)) { %>
        <div>
          <button style="background-color: #f4a900; border: none; border-radius: 8px; color: #fff; font-size: 18px; padding-left: 10px; padding-right: 10px; margin-top: 10px;">내가 작성한 게시물</button>
        </div>
      <% } %>
    </div>
  </div>
</a>
<% } %>
</div>

</center>
<input type="hidden" id="initPage" value="<%= curPage %>">
<input type="hidden" id="totalPage" value="<%= totalPages %>">

<script>
kakao.maps.load(function () {
  const geocoder = new kakao.maps.services.Geocoder();
  const userLat = <%= userLatitude %>;
  const userLng = <%= userLongitude %>;

  if (userLat === 0 || userLng === 0) return;

  const map = new kakao.maps.Map(document.getElementById('map'), {
    center: new kakao.maps.LatLng(userLat, userLng),
    level: 5
  });

  const markerMap = new Map();
  const infoWindowMap = new Map();

  const grouped = {};
  <% for (Map<String, String> m : markerList) {
       String addr = m.get("address");
       if (addr == null || addr.trim().isEmpty()) continue;
  %>
  if (!grouped["<%= addr.replace("\"", "\\\"") %>"]) grouped["<%= addr.replace("\"", "\\\"") %>"] = [];
  grouped["<%= addr.replace("\"", "\\\"") %>"].push({
    diaryId: "<%= m.get("diaryId") %>",
    title: "<%= m.get("title").replace("\"", "\\\"") %>"
  });
  <% } %>

  Object.entries(grouped).forEach(([address, posts]) => {
    geocoder.addressSearch(address, function (result, status) {
      if (status === kakao.maps.services.Status.OK) {
        const lat = parseFloat(result[0].y);
        const lng = parseFloat(result[0].x);
        const coords = new kakao.maps.LatLng(lat, lng);
        const marker = new kakao.maps.Marker({ map, position: coords });
        let html = '<div style="padding:10px; font-size:16px; max-width:250px;">';
        posts.forEach(p => {
          html += '<div style="margin-bottom:4px;"><a href="sub4_text.jsp?diary_id=' + p.diaryId + '&category=나눔창고" ' +
                  'style="display:inline-block; max-width:230px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; color:black; text-decoration:none;">' +
                  p.title + '</a></div>';
        });
        html += '</div>';
        const infoWindow = new kakao.maps.InfoWindow({ content: html });
        markerMap.set(marker, infoWindow);
        infoWindowMap.set(marker, false);

        kakao.maps.event.addListener(marker, 'click', function () {
          const isOpen = infoWindowMap.get(marker);
          if (isOpen) {
            infoWindow.close();
          } else {
            infoWindow.open(map, marker);
          }
          infoWindowMap.set(marker, !isOpen);
        });
      }
    });
  });
});
</script>

<script>
document.querySelectorAll(".pagination .page-btn").forEach(btn => {
  btn.addEventListener("click", function () {
    const page = parseInt(this.dataset.page);
    if (!isNaN(page)) {
      const url = new URL(window.location.href);

      // section 값 유지
      const section = url.searchParams.get("section") || "market";
      url.searchParams.set("section", section);

      // page 값 설정
      url.searchParams.set("page", page);

      // 이동
      window.location.href = url.toString();
    }
  });
});
</script>


</body>
</html>
<%
} catch (Exception e) {
  e.printStackTrace();
} finally {
  if (rs != null) try { rs.close(); } catch (Exception e) {}
  if (pstmt != null) try { pstmt.close(); } catch (Exception e) {}
  if (conn != null) try { conn.close(); } catch (Exception e) {}
}
%>
