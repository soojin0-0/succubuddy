<%@ page language="java" contentType="text/html; charset=euc-kr" pageEncoding="euc-kr" %>
<%@ page import="java.sql.*, java.io.*, java.nio.file.*, java.util.*, javax.servlet.http.Part" %>
<%@ page import="javax.servlet.*" %>
<%@ page import="javax.servlet.http.*" %>
<%@ page import="javax.servlet.annotation.MultipartConfig" %>

<%@ page isELIgnored="false" %>
<%@ page session="true" %>
<%@ page trimDirectiveWhitespaces="true" %>

<%@ page import="javax.servlet.annotation.MultipartConfig" %>
<%! @MultipartConfig %>


<%
request.setCharacterEncoding("euc-kr");

boolean isMultipart = request.getContentType() != null && request.getContentType().toLowerCase().startsWith("multipart/");

String loginId = (String)session.getAttribute("sid");
String username = "";
String title = null;
String writer = null;
String category = null;
String content = null;
String password = null;
boolean hasImage = false;
String imageFileName = null;

Connection conn = null;
PreparedStatement pstmt = null;
ResultSet rs = null;

try {
  Class.forName("org.gjt.mm.mysql.Driver");
  conn = DriverManager.getConnection("jdbc:mysql://localhost:3306/succu", "multi", "abcd");

  // 사용자 이름 조회
  pstmt = conn.prepareStatement("SELECT username FROM user WHERE user_id = ?");
  pstmt.setString(1, loginId);
  rs = pstmt.executeQuery();
  if (rs.next()) {
    username = rs.getString("username");
  }
  rs.close();
  pstmt.close();

  // multipart 처리
  if (isMultipart) {
    Collection<Part> parts = request.getParts();
    for (Part part : parts) {
      String name = part.getName();
      if (name.equals("title")) title = request.getParameter("title");
      else if (name.equals("writer")) writer = request.getParameter("writer");
      else if (name.equals("category")) category = request.getParameter("category");
      else if (name.equals("content")) content = request.getParameter("content");
      else if (name.equals("password")) password = request.getParameter("password");
      else if (name.equals("image")) {
        if (part.getSize() > 0) {
          hasImage = true;
          imageFileName = Paths.get(part.getSubmittedFileName()).getFileName().toString();
          String uploadPath = application.getRealPath("/uploads");
          File uploadDir = new File(uploadPath);
          if (!uploadDir.exists()) uploadDir.mkdirs();
          part.write(uploadPath + File.separator + imageFileName);
        }
      }
    }
  }

  // insert 처리
  if (title != null && writer != null) {
    pstmt = conn.prepareStatement("INSERT INTO diary (title, content, writer, password, views, reg_date, has_image) VALUES (?, ?, ?, ?, 0, NOW(), ?)");
    pstmt.setString(1, title);
    pstmt.setString(2, content);
    pstmt.setString(3, writer);
    pstmt.setString(4, password);
    pstmt.setBoolean(5, hasImage);
    pstmt.executeUpdate();
    pstmt.close();

    response.sendRedirect("sub4.jsp");
    return;
  }

} catch (Exception e) {
  e.printStackTrace(); // 콘솔에 에러 상세 출력
  out.println("<script>alert('오류 발생: " + e.getMessage() + "'); history.back();</script>");
} finally {
  if (conn != null) try { conn.close(); } catch (Exception e) {}
}
%>


<!DOCTYPE html>
<html>
<head>
  <title>다육일기 - 글쓰기</title>
  <style>
  @font-face {
      font-family: 'GmarketSansTTFMedium';
      src: url('fonts/GmarketSansTTFMedium.ttf') format('truetype');
    }

    @font-face {
      font-family: 'GmarketSansTTFBold';
      src: url('fonts/GmarketSansTTFBold.ttf') format('truetype');
    }

    @font-face {
      font-family: 'GmarketSansTTFLight';
      src: url('fonts/GmarketSansTTFLight.ttf') format('truetype');
    }

    @font-face {
      font-family: 'RixInooAriDuriPro';
      src: url('fonts/RixInooAriDuri_Pro Regular.otf') format('opentype');
      font-weight: normal;
      font-style: normal;
    }

    body {
      width: 1920px;
      max-width: 100%;
      overflow-x: hidden;
    }

    .container {
      width: 1719px;
      height: 1481px;
      margin: 60px auto;
    }

    .container-title {
      text-align: center;
      margin: 40px 0 30px;
      font-size: 34px;
      font-family: 'GmarketSansTTFMedium';
    }

  .form-wrapper {
	  width: 1500px;
	  margin: 0 auto;
	  background-color: #f1f6ed;
	  border-radius: 20px;
	  padding: 40px;
	  box-sizing: border-box;
	}
.form-title {
  font-size: 34px;
  font-family: 'GmarketSansTTFMedium';
  color: #111;
  margin-bottom: 30px;
}

.form-row {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

.form-input {
  width: 744px;
  height: 97px;
  background-color: #ffffff;
  border: none;
  border-radius: 15px;
  padding: 0 25px;
  font-size: 25px;
  font-family: 'GmarketSansTTFLight';
  color: #333;
  box-sizing: border-box;
}
select.form-input {
  width: 744px;
  height: 97px;
  background-color: #ffffff;
  border: none;
  border-radius: 15px;
  padding: 0 25px;
  font-size: 20px;
  font-family: 'GmarketSansTTFLight';
  color: #333;
  box-sizing: border-box;
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  background-image: url('images/arrow-big.png');
  background-repeat: no-repeat;
  background-position: right 25px center;
  background-size: 20px;
  line-height: 97px; /* select 안 글자 수직 가운데 맞춤 */
}

textarea {
  width: 100%;
  height: 700px;
  background-color: #ffffff;
  border: none;
  border-radius: 15px;
  padding: 20px;
  font-size: 28px;
  font-family: 'GmarketSansTTFLight';
  box-sizing: border-box;
  margin-bottom: 20px;
}

.form-password-wrapper {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 15px;
}

.password-label {
  font-size: 28px;
  font-family: 'GmarketSansTTFLight';
  color: #555;
}

.password-input {
  width: 248px;
  height: 76px;
  border: none;
  border-radius: 8px;
  padding: 0 10px;
  font-size: 14px;
  font-family: 'GmarketSansTTFLight';
  background-color: white;
  color: #333;
}

/* 파일 업로드 */
.file-upload-wrapper {
  width: 744px;
  height: 97px;
  background-color: #ffffff;
  border-radius: 15px;
  padding: 0 25px;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  cursor: pointer;
}

input[type="file"] {
  display: none;
}

.file-icon {
  width: auto;
  height: 40px;
  margin-right: 10px;
}


#file-name {
  flex-grow: 1;
  font-size: 20px;
  font-family: 'GmarketSansTTFLight';
  color: #333;
}

.file-remove {
  width: 18px;
  height: 18px;
  cursor: pointer;
}
.btn-group-outside {
  width: 1500px;
  margin: 30px auto 80px;
  display: flex;
  justify-content: flex-end;
  gap: 16px;
}

.btn {
  width: 243px;
  height: 99px;
  border: none;
  border-radius: 43px;
  font-size: 30px;
  font-family: 'GmarketSansTTFBold';
  background-color: #67b54d;
  color: white;
  cursor: pointer;
}

.btn:hover {
  background-color: #5da248;
}


  </style>
</head>
<body>
  <div class="container">
    <div class="container-title">다육일기</div>
	<form method="post" enctype="multipart/form-data" id="writeForm">
    <div class="form-wrapper">
		<div class="form-title">글 쓰기</div>
		<div class="form-row">
		  <input type="text" name="title" class="form-input" placeholder="제목">
		  <!-- 사용자에게 보이는 이름 -->
			<input type="text" class="form-input" value="<%= username %>" readonly>

			<!-- 실제 저장용 id -->
			<input type="hidden" name="writer" value="<%= loginId %>">
		</div>

		<div class="form-row">
		  <select name="category" class="form-input">
			<option value="키움백과">키움백과</option>
			<option value="궁금사전">궁금사전</option>
			<option value="나눔창고">나눔창고</option>
			<option value="성장일지">성장일지</option>
		  </select>

		  <div class="file-upload-wrapper" onclick="document.getElementById('imageFile').click();">
			<img src="images/Attach.png" class="file-icon" />
			<span id="file-name">파일을 선택하세요</span>
			<img src="images/cross.png" class="file-remove" id="file-remove" onclick="removeFile(event)">
			<input type="file" id="imageFile" name="image" accept="image/*">
		  </div>
		</div>


		<textarea name="content" placeholder="내용 입력"></textarea>

		<div class="form-password-wrapper">
		  <label class="password-label">비밀번호</label>
		  <input type="password" name="password" class="password-input">
		</div>
		</form>
    </div>
	<!-- form-wrapper 바깥쪽에 등록 버튼 2개 -->
	<div class="btn-group-outside">
	  <button type="button" class="btn cancel-btn" onclick="history.back()">등록 취소</button>
	  <button type="submit" form="writeForm" class="btn submit-btn">등록</button>
	</div>

  </div>
<script>
	function removeFile(e) {
	  e.stopPropagation();
	  const input = document.getElementById('imageFile');
	  document.getElementById('file-name').innerText = '파일을 선택하세요';
	  document.getElementById('file-remove').style.display = 'none';
	  input.value = '';
	}

	document.addEventListener("DOMContentLoaded", function () {
	  const input = document.getElementById("imageFile");
	  input.addEventListener("change", function () {
		if (input.files.length > 0) {
		  document.getElementById("file-name").innerText = input.files[0].name;
		  document.getElementById("file-remove").style.display = "inline";
		}
	  });
	});
</script>


</body>
</html>
