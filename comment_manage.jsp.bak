<%@ page contentType="text/html;charset=euc-kr" pageEncoding="euc-kr" %>
<%@ page import="java.sql.*, java.util.*" %>
<meta charset="euc-kr">
<%
    String loginId = (String) session.getAttribute("sid");
    if (loginId == null || loginId.equals("")) {
        response.sendRedirect("login.jsp");
        return;
    }

    Connection conn = null;
    PreparedStatement ps = null;
    ResultSet rs = null;

    List<Map<String, String>> curiousPosts = new ArrayList<>();
    List<Map<String, String>> sharePosts = new ArrayList<>();

    int currentPage = 1;
    int pageSize = 4;
    int totalPage = 1;
    int totalCount = 0;

    String pageParam = request.getParameter("page");
    if (pageParam != null && pageParam.matches("\\d+")) {
        currentPage = Integer.parseInt(pageParam);
    }

    try {
        Class.forName("org.gjt.mm.mysql.Driver");
        conn = DriverManager.getConnection("jdbc:mysql://localhost:3306/succu", "multi", "abcd");

        String countCurious = "SELECT COUNT(*) FROM sub4_write WHERE category = '궁금톡톡' AND user_id = ?";
        ps = conn.prepareStatement(countCurious);
        ps.setString(1, loginId);
        rs = ps.executeQuery();
        if (rs.next()) {
            totalCount = rs.getInt(1);
            totalPage = (int) Math.ceil((double) totalCount / pageSize);
        }
        rs.close(); ps.close();

        int curiousOffset = (currentPage - 1) * pageSize;
        String listCurious = "SELECT diary_id, title, image_name, category FROM sub4_write WHERE category = '궁금톡톡' AND user_id = ? ORDER BY reg_date DESC LIMIT ? OFFSET ?";
        ps = conn.prepareStatement(listCurious);
        ps.setString(1, loginId);
        ps.setInt(2, pageSize);
        ps.setInt(3, curiousOffset);
        rs = ps.executeQuery();

        while (rs.next()) {
            Map<String, String> post = new HashMap<>();
            post.put("item_id", rs.getString("diary_id"));
            post.put("title", rs.getString("title"));
            post.put("image", rs.getString("image_name"));
            post.put("category", rs.getString("category"));
            curiousPosts.add(post);
        }
        rs.close(); ps.close();

        String listShare = "SELECT diary_id, title, image_name, status FROM sub4_write WHERE category = '나눔창고' AND user_id = ? ORDER BY reg_date DESC";
        ps = conn.prepareStatement(listShare);
        ps.setString(1, loginId);
        rs = ps.executeQuery();

        while (rs.next()) {
            Map<String, String> post = new HashMap<>();
            post.put("item_id", rs.getString("diary_id"));
            post.put("title", rs.getString("title"));
            post.put("image", rs.getString("image_name"));
            post.put("status", rs.getString("status"));
            sharePosts.add(post);
        }
        rs.close(); ps.close(); conn.close();
    } catch (Exception e) {
        e.printStackTrace();
    }
%>
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=euc-kr">
    <style>
	a {
			text-decoration: none;
			color: black;
		}
    @font-face {
      font-family: 'GmarketSansTTFMedium';
      src: url('fonts/GmarketSansTTFMedium.ttf') format('truetype');
    }
    @font-face {
      font-family: 'GmarketSansTTFBold';
      src: url('fonts/GmarketSansTTFBold.ttf') format('truetype');
    }
    @font-face {
      font-family: 'GmarketSansTTFLight';
      src: url('fonts/GmarketSansTTFLight.ttf') format('truetype');
    }
    @font-face {
      font-family: 'RixInooAriDuriPro';
      src: url('fonts/RixInooAriDuri_Pro Regular.otf') format('opentype');
      font-weight: normal;
      font-style: normal;
    }
	body {
      width: 1920px;
      max-width: 100%;
      overflow-x: hidden;
    }
	* {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
	.navbar {
         display: flex;
         justify-content: space-between;
         align-items: center;
         padding: 40px 150px;
         width: 100%;
         margin: 0 auto;
         margin-bottom: 20px; /* 네비게이션 아래 여백 추가 */
		 position: fixed;
		 top: 0;
		 left: 0;
		 z-index: 999;

		/* 반투명 배경 + 블러 처리 */
		  background-color: rgba(255, 255, 255, 1); /* 반투명 흰색 */
		  backdrop-filter: blur(); /* 뒷배경 블러 효과 */
		  -webkit-backdrop-filter: blur(8px); /* 사파리 대응 */
      }

		.logo {
			display: block;
			width: 300px;
			height: 56px;
			margin-left: -30px;
			margin-right: 20px;
		}

		.nav-menu {
			display: flex;
			align-items: center;
			gap: 80px;
		}

		.nav-menu a {
			text-decoration: none;
			color: black;
			font-size: 26px;
			font-weight: 550;
			font-family: 'GmarketSansTTFMedium';
			margin-top: 12px;
		}

		.nav-icons {
			display: flex;
			align-items: center;
			gap: 35px; /* 아이콘 및 로그인 간격 */
			margin-top: 10px; /* 아이콘과 로그인 위치 조정 */
			margin-left: 33px;
		}

		/* 아이콘 크기 조정 */
		.nav-icons img {
			width: 40px;
			height: 40px;
		}

		/* 로그아웃 링크 스타일 */
		.nav-login {
			text-decoration: none;
			font-size: 24px;
			font-family: 'GmarketSansTTFMedium';
			color: black;
			margin-top:10px;
		}
		.footer {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 1920px;
            height: 283px;
            padding: 0 150px; /* 왼쪽과 오른쪽 패딩 조정 */
            background-color: #60af46;
        }

        .footer-left,
        .footer-right {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .footer-left {
            font-size: 45px;
            font-family: 'RixInooAriDuriPro'; /* Medium font 적용 */
            margin-left: 35px;
			color: #ffffff;
        }

        .footer-right {
            font-size: 16px;
            color: #ffffff;
            margin-left: 177px;
            font-family: 'GmarketSansTTFLight'; /* Light font 적용 */
        }

        .footer-right span {
            margin-bottom: 10px;
        }

        .footer-right a {
            text-decoration: none;
            color: #ffffff;
        }

		.container-title {
      text-align: center;
      margin: 200px 0 30px;
      font-size: 34px;
      font-family: 'GmarketSansTTFMedium';

    }
		.board-wrapper {
			width: 1500px;
			margin: 60px auto;
			background: #f1f6ed;
			padding: 30px;
			border-radius: 20px;
			font-family: 'GmarketSansTTFLight';
			overflow: visible; /* ← 여기만 고치면 됨 */
		}

		.board-title-header {
			font-size: 32px;
			font-family: 'GmarketSansTTFMedium';
			margin-bottom: 20px;
			color: #333;
			text-align: left;
			width: 1500px;
		}
		.board-item {
			display: flex;
			align-items: center;
			gap: 32px; /* 이미지와 제목 사이의 간격을 32px로 설정 */
			height: 112px;
			border-bottom: 1px solid #c8dcc0;
			font-size: 24px;
			color: #333;
			min-height: 50px;
		}

		.board-item img {
			width: 80px; /* 이미지의 크기 설정 */
			height: 80px;
			object-fit: cover;
			border-radius: 10px;
		}

		.board-title {
			font-size: 32px; /* 제목 크기 32px로 설정 */
			color: #333;
		}
		  .board-title a {
			color: #333 !important;
			text-decoration: none !important;
		  }

		  .board-title a:visited,
		  .board-title a:active,
		  .board-title a:hover {
			color: #333 !important;
			text-decoration: none !important;
		  }

        .pagination {
			display: flex;
			gap: 10px;
			background-color: #f2f7ef;
			padding: 10px 20px;
			border-radius: 43px;
			margin-left: 600px;
			margin-top: 30px;
			text-decoration: none;
		}

		.page-btn {
			background: none;
			border: none;
			font-size: 20px;
			font-family: 'GmarketSansTTFMedium';
			color: #333;
			cursor: pointer;
			padding: 6px 10px;
			border-radius: 8px;
			transition: 0.2s;
			text-decoration: none;
		}

		.page-btn.active {
			background-color: #4caf50;
			color: white;
		}

		.page-btn:hover:not(.active) {
			background-color: #e0eed9;
		}
		.page-btn.disabled {
		  pointer-events: none;
		  opacity: 0.4;
		}

		.share-status-container {
			width: 1500px;
			height: 500px;
			margin: 60px auto;
			font-family: 'GmarketSansTTFLight';
		  }

		  .share-status-title {
			font-size: 32px;
			font-family: 'GmarketSansTTFMedium';
			margin-bottom: 20px;
			color: #333;
			width: 1500px;
			text-align: left;
		  }

.share-status-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  background: #f1f6ed;
  border-radius: 24px;
  padding: 30px 40px;
  margin: 60px auto;
  width: 1500px;
  position: relative;
}
		  .slide-arrow {
			background: none;
			border: none;
			cursor: pointer;
			margin-left:50px;
			margin-right: 50px;
		  }

		  .slide-arrow img {
			width: 100px;
			height:auto;
		  }

.status-card {
  flex-shrink: 0;
  width: 160px;
  height: 160px;
  position: relative;
}

.status-image-wrapper {
  width: 160px;
  height: 160px;
  border-radius: 16px;
  background: white;
  overflow: hidden;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-image {
  width: 160px;
  height: 160px;
  object-fit: cover;
  border-radius: 16px;
}

		.status-link {
		  display: block;
		  width: 100%;
		  height: 100%;
		  text-decoration: none;
		}

.status-image-wrapper {
  width: 160px;
  height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background-color: white;
  overflow: hidden;
  position: relative;
}


.img-wrapper {
  width: 100%;
  height: 100%;
}

.img-overlay {
  position: absolute;
  top: 0;
  left: 0;
  background: rgba(0,0,0,0.5);
  width: 100%;
  height: 100%;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-family: 'GmarketSansTTFBold';
  z-index: 2;
}

.status-image {
  width: 160px;
  height: 160px;
  object-fit: cover;
  border-radius: 16px;
  position: relative;
  z-index: 1;
}
.status-cards {
  transition: transform 0.3s ease-in-out;
}

    </style>
	</head>
	<body>
    <header class="navbar">
      <a href="main.jsp">
      <img src="images/logo.png" alt="SuccuBuddy Logo" class="logo">
      </a>
      <nav class="nav-menu">
         <a href="sub1.jsp">다육 세트</a>
         <a href="sub2.jsp">다육 단품</a>
         <a href="sub3.jsp">맞춤 다육 추천</a>
         <a href="sub4.jsp">다육 탐구 생활</a>
         <a href="sub5.jsp">고객센터</a>
      </nav>
      <div class="nav-icons">
         <a href="mypage.jsp"><img src="images/Person.png" alt="사용자"></a>
         <a href="shopping_list.jsp"><img src="images/cart.png" alt="장바구니"></a>
         <a href="logout.jsp" class="nav-login">로그아웃</a> 
      </div>
   </header>

	<div class="container-title"><a href="sub4.jsp">다육 탐구 생활</a></div>
<center>
  <div class="board-title-header">궁금톡톡</div>
</center>
<div class="board-wrapper" id="question-board">
  <% for (Map<String, String> p : curiousPosts) { %>
    <div class="board-item">
        <% if (p.get("image") != null && !p.get("image").trim().equals("")) { %>
            <img src="/uploads/<%= p.get("image") %>" alt="썸네일">
        <% } %>
        <div class="board-title">
            <a href="sub4_text.jsp?diary_id=<%= p.get("item_id") %>&category=궁금톡톡"><%= p.get("title") %></a>
        </div>
    </div>
  <% } %>
  <div class="pagination">
      <button type="button" class="page-btn <%= (currentPage == 1 ? "disabled" : "") %>" data-page="<%= currentPage - 1 %>">&lt;</button>
      <% for (int i = 1; i <= totalPage; i++) { %>
          <button type="button" class="page-btn <%= (i == currentPage ? "active" : "") %>" data-page="<%= i %>"><%= i %></button>
      <% } %>
      <button type="button" class="page-btn <%= (currentPage == totalPage ? "disabled" : "") %>" data-page="<%= currentPage + 1 %>">&gt;</button>
  </div>
</div>

<!-- 나눔창고 슬라이드 섹션 -->
<center>
  <div class="share-status-title">나눔창고</div>
</center>
<div class="share-status-container">
  <div class="share-status-wrapper">

    <!-- 좌측 화살표 버튼 -->
    <button class="slide-arrow left">
      <img src="images/left_arrow.png" alt="이전">
    </button>

    <!-- 슬라이드 리스트 -->
    <ul class="bxslider">
      <% for (Map<String, String> post : sharePosts) { %>
        <li>
          <a href="sub4_text.jsp?diary_id=<%= post.get("item_id") %>&category=나눔창고">
            <div class="status-image-wrapper">
              <% if (post.get("image") != null && !post.get("image").trim().equals("")) { %>
                <img src="/uploads/<%= post.get("image") %>" alt="썸네일" class="status-image">
                <% if ("나눔완료".equals(post.get("status"))) { %>
                  <div class="img-overlay">나눔완료</div>
                <% } %>
              <% } %>
            </div>
          </a>
        </li>
      <% } %>
    </ul>

    <!-- 우측 화살표 버튼 -->
    <button class="slide-arrow right">
      <img src="images/right_arrow.png" alt="다음">
    </button>

  </div>
</div>

<footer class="footer">
    <div class="footer-left">
        <span class="brand-name">succubuddy</span>
    </div>
    <div class="footer-right">
	<br>
        <span>주소 : 충청남도 천안시 서북구 성환읍 대학로 91 | EMAIL : succubuddy@naver.com</span>
        <span>TEL : 070-022-2026 | &copy; 2025 succubuddy. All Rights Reserved.</span>
		<br>
        <span><a href="footer_policy">개인정보처리방침</a> | <a href="footer_terms">이용약관</a></span>
    </div>
</footer>

<script>
function loadCuriousPage(page) {
  fetch("comment_question_data.jsp?page=" + page)
    .then(res => res.arrayBuffer())
    .then(buffer => {
      const decoder = new TextDecoder("euc-kr");
      const html = decoder.decode(buffer);
      document.getElementById("question-board").innerHTML = html;
      bindCuriousPagination();
    });
}

function bindCuriousPagination() {
  const btns = document.querySelectorAll(".pagination .page-btn");
  btns.forEach(btn => {
    btn.addEventListener("click", function () {
      if (this.classList.contains("disabled")) return;
      const page = this.dataset.page;
      loadCuriousPage(page);
    });
  });
}

// 궁금톡톡만 초기 실행
setTimeout(() => {
  bindCuriousPagination();
}, 0);
</script>

<script src="js/jquery-2.2.4.min.js"></script>
<script src="js/jquery.bxslider.js"></script>

<script>
  let slider;

  $(document).ready(function () {
    slider = $('.bxslider').bxSlider({
      mode: 'horizontal',
      slideWidth: 160,
      slideMargin: 50,
      minSlides: 4,
      maxSlides: 4,
      moveSlides: 1,
      pager: false,
      controls: false,
      preventDefaultSwipeX: false,
	  touchEnabled: false
    });

    // 화살표 클릭 이벤트
    document.querySelector(".slide-arrow.left").addEventListener("click", function () {
      slider.goToPrevSlide();
    });

    document.querySelector(".slide-arrow.right").addEventListener("click", function () {
      slider.goToNextSlide();
    });
  });
</script>

</body>
</html>