<%@ page contentType="text/html; charset=euc-kr" pageEncoding="euc-kr" %>
<%@ page import="java.io.*, javax.servlet.*, javax.servlet.http.*, java.util.*" %>
<%
  String content = request.getParameter("content");

  if (content != null) {
    switch (content) {
      case "health-info":
        out.println("<p>다육 건강 관리 자세히 알아보세요...</p>");
        break;
      case "health-disease":
        out.println("<p>병충해 관리 방법...</p>");
        break;
      case "daily-care":
        out.println("<p>일상 관리 방법...</p>");
        break;
      case "daily-pruning":
        out.println("<p>가지치기 관리 방법...</p>");
        break;
      case "seasonal-spring":
        out.println("<p>봄철 관리...</p>");
        break;
      case "seasonal-summer":
        out.println("<p>여름철 관리...</p>");
        break;
      case "seasonal-winter":
        out.println("<p>겨울철 관리...</p>");
        break;
      case "water-frequency":
        out.println("<p>물 주는 빈도...</p>");
        break;
      case "water-method":
        out.println("<p>물 주는 방법...</p>");
        break;
      case "nutrition-fertilizer":
        out.println("<p>영양 관리...</p>");
        break;
      default:
        out.println("<p>알 수 없는 콘텐츠 요청입니다.</p>");
    }
  }
%>
