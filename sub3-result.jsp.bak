			font-size: 20px;
			margin-left: 20px;
			margin-right: 20px;
		}
	</style>
</head>
<body>
	    <header class="navbar">
      <a href="main.jsp">
      <img src="images/logo.png" alt="SuccuBuddy Logo" class="logo">
      </a>
      <nav class="nav-menu">
         <a href="sub1.jsp">다육 세트</a>
         <a href="sub2.jsp">다육 단품</a>
         <a href="sub3.jsp">맞춤 다육 추천</a>
         <a href="sub4.jsp">다육 탐구 생활</a>
         <a href="sub5.jsp">고객센터</a>
      </nav>
      <div class="nav-icons">
         <a href="mypage.jsp"><img src="images/Person.png" alt="사용자"></a>
         <a href="shopping_list.jsp"><img src="images/cart.png" alt="장바구니"></a>
         <a href="logout.jsp"><img src="images/logout.png" alt="로그아웃"></a> 
      </div>
   </header>

	<div class="recommend-left">
		<p>나에게 어울리는 다육</p>
		<p id="name"><%= productName %></p>


		<% if (!recommendedProduct.equals("추천할 다육을 찾을 수 없습니다.")) { %>
			<img src="images/<%= recommendedProduct %>.png" alt="<%= productName %>" width="300">
		<% } else { %>
			<p>이미지를 찾을 수 없습니다.</p>
		<% } %>
	</div>

	<div class="recommend-right">
	  <%
    // 문장 조합
    String q1 = userAnswers.size() > 0 && userAnswers.get(0).equals("1") ? "이미 다육을 키워본 경험이 있으시군요!" : "다육이를 키워본 경험이 없으시군요!";
    String q2 = userAnswers.size() > 1 && userAnswers.get(1).equals("1") ? "실내에서 키울 예정이며," : "실외에서 키울 예정이며,";
    String q3 = userAnswers.size() > 2 && userAnswers.get(2).equals("1") ? "온도, 습도가 일정하여 건강하게 키우기 좋은 환경입니다." : "온도, 습도를 신경써야 하는 환경입니다.";

    String q4Size = "", q5Pet = "", q6Budget = "";

    if (userAnswers.size() > 3) {
        switch (userAnswers.get(3)) {
            case "1": q4Size = "작은 다육을 원하시고 "; break;
            case "2": q4Size = "적당한 크기의 다육을 원하시고 "; break;
            case "3": q4Size = "큰 다육을 원하시고 "; break;
        }
    }

    if (userAnswers.size() > 4) {
        q5Pet = userAnswers.get(4).equals("1") ? "반려동물을 키우시니 관리가 더 신중해야겠네요." : "반려동물이 없어 관리가 더욱 수월하겠네요.";
    }

    if (userAnswers.size() > 5) {
        switch (userAnswers.get(5)) {
            case "1":
                q6Budget = "가성비가 좋은 <span class=\"point\">" + productName + "</span>을 추천드립니다!";
                break;
            case "2":
                q6Budget = "다양한 다육 중에서 <span class=\"point\">" + productName + "</span>을 추천드립니다!";
                break;
            case "3":
                q6Budget = "희귀하거나 독특한 다육 중에서 <span class=\"point\">" + productName + "</span>을 추천드립니다!";
                break;
        }
    }
%>

<div class="text-group">
	<p><span class="jul"><%= q1 %></span></p>
	<p><%= q2 %></p>
	<p><%= q3 %></p>
	<p><%= q4Size + q5Pet %></p>
	<p><%= q6Budget %></p>
</div>

	
	<table class="line">
		<tr><td></td></tr>
	</table>
	 
	<div class="characteristic-wrapper">
		<div class="characteristic">특징</div>
		<div class="characteristic-detail"><%= description %></div>
	</div>

	</div>
	<div class="container">
	  <table id="detail">
		<tr>
		  <td style="border-right: 2px solid #7ab863; border-bottom: 2px solid #7ab863;">
			<div style="display: flex; align-items: center; gap: 10px; margin-top: 10px; margin-bottom: 30px;">
			  <img src="images/r_water.png">
			  <span style="font-family: 'GmarketSansTTFMedium'; font-size: 22px; color: #7ab863; margin-left: 10px;">물</span>
			</div>
			<font><%= water %></font><br>
			<p><%= water_detail %></p>
		  </td>
		  <td style="border-left: 2px solid #7ab863; border-bottom: 2px solid #7ab863;">
			<div style="display: flex; align-items: center; gap: 10px; margin-top: 10px; margin-bottom: 30px;">
			  <img src="images/r_temperature.png">
			  <span style="font-family: 'GmarketSansTTFMedium'; font-size: 22px; color: #7ab863; margin-left: 10px;">온도</span>
			</div>
			<font><%= temperature_detail %></font><br>
			<p><%= temperature %></p>
		  </td>
		</tr>
		<tr>
		  <td style="border-top: 2px solid #7ab863; border-right: 2px solid #7ab863;">
			<div style="display: flex; align-items: center; gap: 10px; margin-top: 10px; margin-bottom: 30px;">
			  <img src="images/r_sun.png">
			  <span style="font-family: 'GmarketSansTTFMedium'; font-size: 22px; color: #7ab863; margin-left: 10px;">빛</span>
			</div>
			<font><%= sun %></font><br>
			<p><%= sun_detail %></p>
		  </td>
		  <td style="border-top: 2px solid #7ab863; border-left: 2px solid #7ab863;">
			<div style="display: flex; align-items: center; gap: 10px; margin-top: 10px; margin-bottom: 30px;">
			  <img src="images/r_cloud.png">
			  <span style="font-family: 'GmarketSansTTFMedium'; font-size: 22px; color: #7ab863; margin-left: 10px;">습도</span>
			</div>
			<font><%= humidity %></font><br>
			<p><%= humidity_detail %></p>
		  </td>
		</tr>
	  </table>


		<div class="btn">
			<button class="reset" onclick="location.href='sub3.jsp';" value="돌아가기">돌아가기</button>
			<button class="go" value="구매하기"><a href="productDetail.jsp?product_id=<%= recommendedProduct %>" style="color: #7ab863">구매하기</a></button>
		</div>
	</div>

<footer class="footer">
    <div class="footer-left">
        <span class="brand-name">succubuddy</span>
    </div>
    <div class="footer-right">
	<br>
        <span>주소 : 충청남도 천안시 서북구 성환읍 대학로 91 | EMAIL : succubuddy@naver.com</span>
        <span>TEL : 070-022-2026 | &copy; 2025 succubuddy. All Rights Reserved.</span>
		<br>
        <span><a href="#">개인정보처리방침</a> | <a href="#">이용약관</a></span>
    </div>
</footer>
</body>
</html>
