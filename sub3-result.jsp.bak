<%@ page contentType="text/html;charset=euc-kr" %>
<%@ page import="java.sql.*, java.util.List, java.util.ArrayList" %>
<%
    request.setCharacterEncoding("euc-kr");

    // 세션에서 사용자의 답변 리스트 가져오기
    List<String> userAnswers = (List<String>) session.getAttribute("userAnswers");

    // userAnswers가 null이면 새로운 리스트 생성
    if (userAnswers == null) {
        userAnswers = new ArrayList<>();
    }

    // 마지막 질문의 답변을 URL에서 가져와 리스트에 추가
    String lastAnswer = request.getParameter("answer_id");
    if (lastAnswer != null && !lastAnswer.isEmpty()) {
        userAnswers.add(lastAnswer);
        session.setAttribute("userAnswers", userAnswers); // 세션에 다시 저장
    }

    // userAnswers가 비어있지 않은 경우에만 answerCombination 생성
    String answerCombination = userAnswers.isEmpty() ? "" : String.join(",", userAnswers);

    // answerCombination이 비어있는 경우 기본 메시지 설정
    if (answerCombination.isEmpty()) {
        answerCombination = "데이터 없음";
    }

    Connection conn = null;
    PreparedStatement pstmt = null;
    ResultSet rs = null;
    String recommendedProduct = "추천할 다육을 찾을 수 없습니다.";
    String productName = "";
    String productDescription = "";
    String productCategory = "";
    String productPrice = "";
    String productPlace = "";
    String productPetSafe = "";

	// 상세 정보 추가
    String water = "";
    String water_detail = "";
    String temperature = "";
    String temperature_detail = "";
    String sun = "";
    String sun_detail = "";
    String humidity = "";
    String humidity_detail = "";
    String description = "";

    try {
        // DB 연결 정보
        String DB_URL = "jdbc:mysql://localhost:3306/succu";
        String DB_ID = "multi"; 
        String DB_PASSWORD = "abcd"; 
 	 
        Class.forName("org.gjt.mm.mysql.Driver");  
        conn = DriverManager.getConnection(DB_URL, DB_ID, DB_PASSWORD);

        // recommendation_rule 테이블에서 product_id 가져오기
        String sql = "SELECT product_id FROM recommendation_rule WHERE answer_combination = ?";
        pstmt = conn.prepareStatement(sql);
        pstmt.setString(1, answerCombination);
        rs = pstmt.executeQuery();

        if (rs.next()) {
            recommendedProduct = rs.getString("product_id");
        }
        rs.close();
        pstmt.close();

        // product 테이블에서 상품 기본 정보 가져오기
        if (!recommendedProduct.equals("추천할 다육을 찾을 수 없습니다.")) {
            sql = "SELECT name, category_id, price, place, pet_safe FROM product WHERE product_id = ?";
            pstmt = conn.prepareStatement(sql);
            pstmt.setString(1, recommendedProduct);
            rs = pstmt.executeQuery();

            if (rs.next()) {
                productName = rs.getString("name");
                productCategory = rs.getString("category_id");
                productPrice = rs.getString("price");
                productPlace = rs.getString("place");
                productPetSafe = rs.getString("pet_safe");
            }
            rs.close();
            pstmt.close();

            // succu_detail 테이블에서 상세 정보 가져오기
            sql = "SELECT water, water_detail, temperature, temperature_detail, sun, sun_detail, humidity, humidity_detail, description FROM succu_detail WHERE product_id = ?";
            pstmt = conn.prepareStatement(sql);
            pstmt.setString(1, recommendedProduct);
            rs = pstmt.executeQuery();

            if (rs.next()) {
                water = rs.getString("water");
                water_detail = rs.getString("water_detail");
                temperature = rs.getString("temperature");
                temperature_detail = rs.getString("temperature_detail");
                sun = rs.getString("sun");
                sun_detail = rs.getString("sun_detail");
                humidity = rs.getString("humidity");
                humidity_detail = rs.getString("humidity_detail");
                description = rs.getString("description");
            }
        }
    } catch (Exception e) {
        e.printStackTrace();
    } finally {
        if (rs != null) rs.close();
        if (pstmt != null) pstmt.close();
        if (conn != null) conn.close();
    }

    // 세션 초기화 (다시 처음부터 시작 가능)
    session.removeAttribute("userAnswers");
%>

<!-- succu_detail -->



<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="euc-kr">
    <title>맞춤다육추천 결과</title>
	<style>
		a {
			text-decoration: none;
		}
        @font-face {
            font-family: 'GmarketSansTTFMedium';
            src: url('fonts/GmarketSansTTFMedium.ttf') format('truetype');
        }
        
        @font-face {
            font-family: 'GmarketSansTTFBold';
            src: url('fonts/GmarketSansTTFBold.ttf') format('truetype');
        }
        
        @font-face {
            font-family: 'GmarketSansTTFLight';
            src: url('fonts/GmarketSansTTFLight.ttf') format('truetype');
        }
		@font-face {
             font-family: 'RixInooAriDuriPro';  /* 폰트 이름 지정 */
	     src: url('fonts/RixInooAriDuri_Pro Regular.otf')  format('opentype'); /* OTF 파일은 'opentype' 지정 */
	     font-weight: normal;
	     font-style: normal;
         }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            border: none;
			outline: none;
			margin: 0;
			padding: 0;
			width: 100%;
			max-width: 100%;
			overflow-x: hidden; /* 가로 스크롤 방지 */
        }
		.navbar {
         display: flex;
         justify-content: space-between;
         align-items: center;
         padding: 40px 150px;
         width: 100%;
         margin: 0 auto;
         margin-bottom: 20px; /* 네비게이션 아래 여백 추가 */
		 position: fixed;
		 top: 0;
		 left: 0;
		 z-index: 999;

		/* 반투명 배경 + 블러 처리 */
		  background-color: rgba(255, 255, 255, 1); /* 반투명 흰색 */
		  backdrop-filter: blur(); /* 뒷배경 블러 효과 */
		  -webkit-backdrop-filter: blur(8px); /* 사파리 대응 */
      }

      .logo {
         display: block;
         width: 300px;
         height: 56px;
         margin-left: -10px;
         margin-right: 20px;
      }

      .nav-menu {
         display: flex;
         align-items: center;
         gap: 63px;
      }

      .nav-menu a {
         text-decoration: none;
         color: black;
         font-size: 26px;
         font-weight: 550;
         font-family: 'GmarketSansTTFMedium';
         margin-top: 12px;
      }

      .nav-icons {
         display: flex;
         align-items: center;
         gap: 35px; /* 아이콘 및 로그인 간격 */
         margin-top: 10px; /* 아이콘과 로그인 위치 조정 */
         margin-left: 33px;
      }
		/* 아이콘 크기 조정 */
      .nav-icons img {
         width: 40px;
         height: 40px;
      }

      /* 로그인 링크 스타일 */
      .nav-login {
         text-decoration: none;
         font-size: 24px;
         font-family: 'GmarketSansTTFMedium';
         color: black;
         margin-top:10px;
      }

		/* 로그아웃 링크 스타일 */
		.nav-logout {
			text-decoration: none;
			font-size: 24px;
			font-family: 'GmarketSansTTFMedium';
			color: black;
			margin-top:10px;
		}
  
        p {
            font-family: 'GmarketSansTTFLight';
        }

        h2 {
            font-family: 'GmarketSansTTFBold';
        }

        h6 {
            font-family: 'GmarketSansTTFMedium';
        }

		/*푸터*/
       .footer {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 1920px;
            height: 283px;
            padding: 0 150px; /* 왼쪽과 오른쪽 패딩 조정 */
            background-color: #60af46;
        }

        .footer-left,
        .footer-right {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .footer-left {
            font-size: 50px;
            font-family: 'RixInooAriDuriPro'; /* Medium font 적용 */
            margin-left: 50px;
            color: #ffffff;
        }

        .footer-right {
            font-size: 18px;
            color: #ffffff;
            margin-left: 130px;
            font-family: 'GmarketSansTTFLight'; /* Light font 적용 */
        }

        .footer-right span {
            margin-bottom: 10px;
        }

        .footer-right a {
            text-decoration: none;
            color: #ffffff;
        }

		.recommend-left {
			float: left;
			margin-left: 200px;
		}
		.recommend-left p {
			font-family: 'GmarketSansTTFLight';
			font-size: 28px;
			text-align: center;
			margin-bottom: 30px;
		}
		.recommend-left #name {
			font-family: 'GmarketSansTTFMedium';
			font-size: 55px;
			color: #7ab863;
		}
		.recommend-left img {
			width: 550px;
			height: 550px;
			margin-bottom: 60px;
		}
		.recommend-left #description {
			width: 1100px;
			font-family: 'GmarketSansTTFLight';
			font-size: 24px;
			padding-bottom: 20px;
		}
		.recommend-right {
			width: 1100px;
			height: 800px;
			background-image: url("images/text.png");
			background-repeat: no-repeat;
			background-size: 90%;
			background-position: center;
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding: 100px 100px;
			box-sizing: border-box;
			margin-top: 200px;
		}
		.text-group {
			 
		}
		.recommend-right p {
			margin-left: 80px;
			padding-bottom: 10px;
			font-size: 28px;
			text-align: center;
		}

		.jul {
			display: inline-block; /* 또는 block */
			border-bottom: 2px solid #f4a900;
		}
		.point {
			background-color: #fff;
			color: #7ab863;
			font-family: 'GmarketSansTTFMedium';
		}
		.point2 {
			color: #f4a900;
			font-family: 'GmarketSansTTFMedium';
			font-size: 24px;
		}

		.line {
			border-top: 2px solid #7ab863;
			width: 718px;
			margin-top: 80px;
			margin-bottom: 50px;
			margin-left: 130px;
		}
		.characteristic-wrapper {
			display: flex;
			align-items: flex-start;
			margin-left: 140px;
			margin-top: 50px;
			gap: 20px; /* "특징"과 설명 사이 간격 */
		}

		.characteristic {
			font-family: 'GmarketSansTTFMedium';
			font-size: 32px;
			white-space: nowrap; /* 줄바꿈 없이 한 줄 유지 */
		}

		.characteristic-detail {
			font-family: 'GmarketSansTTFLight';
			font-size: 20px;
			line-height: 1.8;
			max-width: 700px;
			margin-left: 30px;
			font-size: 24px;
		}

		.container {
			margin-top: 100px;
			width: 100%;
			height: auto;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center; /* 가로 중앙 정렬 */
		}

		.container #detail {
			width: 1260px;
			height: 450px;
			border-collapse: collapse;
			margin: 0 auto;
		}
		.container #detail td {
			margin-left: 30px;
			text-align: left;
			vertical-align: top;
			width: 630px;
		}
		.container #detail img {
			width: auto;
			height: auto;
			display: block;
			margin-top: 10px;
			margin-bottom: 5px;
			margin-left: 30px;
		}
		.container #detail font {
			font-family: 'GmarketSansTTFMedium';
			font-size: 24px;
			padding-bottom: 5px;
			display: block;
			margin-left: 30px;
		}
		.container #detail p {
			font-family: 'GmarketSansTTFLight';
			font-size: 24px;
			text-align: left;
			padding-bottom: 5px;
			margin-left: 30px;
			margin-bottom: 30px;
		}
		/* 버튼 */
		.btn {
			margin-top: 160px;
			align-items: center;
			margin-bottom: 200px;
		}
		.reset {
			width: 160px;
			height: 40px;
			border-radius: 8px;
			background-color: #7ab863;
			color: #fff;
			border: none;
			font-family: 'GmarketSansTTFLight';
			font-size: 20px;
			margin-left: 20px;
			margin-right: 20px;
		}

		.go {
			width: 160px;
			height: 40px;
			border: 1px solid #7ab863;
			border-radius: 8px;
			background-color: #fff;
			color: #7ab863;
