<%@ page contentType="text/plain; charset=euc-kr" pageEncoding="euc-kr" %>
<%@ page import="java.sql.*" %>
<%
request.setCharacterEncoding("euc-kr");

String diaryId = request.getParameter("diary_id");
if (diaryId == null || !diaryId.matches("\\d+")) {
    out.print("유효하지 않은 요청입니다.");
    return;
}

Connection conn = null;
PreparedStatement ps = null;

try {
    Class.forName("org.gjt.mm.mysql.Driver");
    conn = DriverManager.getConnection("jdbc:mysql://localhost:3306/succu?useUnicode=true&characterEncoding=euc-kr", "multi", "abcd");

    ps = conn.prepareStatement("DELETE FROM diary WHERE diary_id = ?");
    ps.setString(1, diaryId);
    int result = ps.executeUpdate();

    if (result > 0) {
        out.print("SUCCESS");
    } else {
        out.print("삭제할 데이터가 없습니다.");
    }

    ps.close();
    conn.close();
} catch (Exception e) {
    out.print("오류 발생: " + new String(e.getMessage().getBytes("8859_1"), "euc-kr"));
}
%>
