<%@ page contentType="text/html;charset=euc-kr" %>
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=euc-kr">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>자주묻는질문</title>
    <style>
		a {
			text-decoration: none;
			color: black;
		}
        @font-face {
            font-family: 'GmarketSansTTFMedium';
            src: url('fonts/GmarketSansTTFMedium.ttf') format('truetype');
        }
        
        @font-face {
            font-family: 'GmarketSansTTFBold';
            src: url('fonts/GmarketSansTTFBold.ttf') format('truetype');
        }
        
        @font-face {
            font-family: 'GmarketSansTTFLight';
            src: url('fonts/GmarketSansTTFLight.ttf') format('truetype');
        }
		@font-face {
			font-family: 'RixInooAriDuriPro';  /* 폰트 이름 지정 */
			src: url('fonts/RixInooAriDuri_Pro Regular.otf')  format('opentype'); /* OTF 파일은 'opentype' 지정 */
			font-weight: normal;
			font-style: normal;
		}
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            width: 1920px;
            max-width: 100%; /* 화면 크기에 맞춰 자동 조정 */
            overflow-x: hidden;
        }

.navbar {
         display: flex;
         justify-content: space-between;
         align-items: center;
         padding: 40px 150px;
         width: 100%;
         margin: 0 auto;
         margin-bottom: 20px; /* 네비게이션 아래 여백 추가 */
       position: fixed;
       top: 0;
       left: 0;
       z-index: 999;

      /* 반투명 배경 + 블러 처리 */
        background-color: rgba(255, 255, 255, 1); /* 반투명 흰색 */
        backdrop-filter: blur(); /* 뒷배경 블러 효과 */
        -webkit-backdrop-filter: blur(8px); /* 사파리 대응 */
      }

      .logo {
         display: block;
         width: 300px;
         height: 56px;
         margin-left: -30px;
         margin-right: 20px;
      }

      .nav-menu {
         display: flex;
         align-items: center;
         gap: 80px;
      }

      .nav-menu a {
         text-decoration: none;
         color: black;
         font-size: 26px;
         font-weight: 550;
         font-family: 'GmarketSansTTFMedium';
         margin-top: 12px;
      }

      .nav-icons {
         display: flex;
         align-items: center;
         gap: 35px; /* 아이콘 및 로그인 간격 */
         margin-top: 10px; /* 아이콘과 로그인 위치 조정 */
         margin-left: 33px;
      }

      /* 아이콘 크기 조정 */
      .nav-icons img {
         width: 40px;
         height: 40px;
      }

      /* 로그아웃 링크 스타일 */
      .nav-login {
         text-decoration: none;
         font-size: 24px;
         font-family: 'GmarketSansTTFMedium';
         color: black;
         margin-top:10px;
      }


      /* 로그인 링크 스타일 */
      .nav-login {
         text-decoration: none;
         font-size: 24px;
         font-family: 'GmarketSansTTFMedium';
         color: black;
         margin-top:10px;
      }
  
        p {
            font-family: 'GmarketSansTTFLight';
        }

        h2 {
            font-family: 'GmarketSansTTFBold';
        }

        h6 {
            font-family: 'GmarketSansTTFMedium';
        }

		/*푸터*/
       .footer {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 1920px;
            height: 283px;
            padding: 0 150px; /* 왼쪽과 오른쪽 패딩 조정 */
            background-color: #60af46;
        }

        .footer-left,
        .footer-right {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .footer-left {
            font-size: 50px;
            font-family: 'RixInooAriDuriPro'; /* Medium font 적용 */
            margin-left: 50px;
            color: #ffffff;
        }

        .footer-right {
            font-size: 18px;
            color: #ffffff;
            margin-left: 130px;
            font-family: 'GmarketSansTTFLight'; /* Light font 적용 */
        }

        .footer-right span {
            margin-bottom: 10px;
        }

        .footer-right a {
            text-decoration: none;
            color: #ffffff;
        }

/* 가운데 정렬을 위한 공통 스타일 */
.center-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* 고객센터 */
.title {
	font-size: 34px;
	margin-bottom: 80px;
	font-family: 'GmarketSansTTFMedium';
}

/* 탭메뉴 */
.tab-menu {
	display: flex;              /* 가로로 나열하기 위해 Flex 사용 */
	border: none;
	width: 1100px;
	height: 78px;
	border-radius: 8px;
	overflow: hidden;
	font-family: 'GmarketSansTTFMedium';
}

.tab {
	flex: 1;                   /* 공간 균등 분할 */
	display: flex;               /* Flexbox 사용 */
	align-items: center;         /* 세로 중앙 정렬 */
	justify-content: center;     /* 가로 중앙 정렬 */
	padding: 10px 0;
	border-right: 2px solid #000;
	box-sizing: border-box;
	background-color: #f5f5f5;
	font-size: 20px;
	cursor: pointer;
}

.tab:last-child {
	border-right: none;        /* 마지막 탭은 테두리 제거 */
}

.tab.active {
	background-color: #7ab863;
	color: #fff;
}

/* 검색창 */
.search {
	position: relative;
	width: 600px;
}

.search input{
	width: 100%;
	height: 74px;
	border: 1px solid #000;
	border-radius: 8px;
	margin-top: 60px;
	padding-right: 55px;
	padding-left: 15px;
	font-size: 18px;
	box-sizing: border-box;
	font-family: 'GmarketSansTTFLight';
}

.search img {
	position: absolute;
	right: 17px;
	top: 73%;
	transform: translateY(-50%);
	cursor: pointer;
}

/* 자주묻는질문 */
.FAQ {
	width: 1100px;
	border: none;
	margin-top: 50px;
	margin-bottom: 120px;
	border-collapse: collapse; /* 테두리 겹침 방지 */
}

.FAQ td {
	font-size: 20px;
	border-bottom: 1px solid #000;
	padding-left: 5px;
	padding-right: 5px;
	padding-top: 40px;
	padding-bottom: 40px;
}

.FAQ td:first-child {
	font-family: 'GmarketSansTTFMedium';
	width: 250px;
}
.FAQ td:nth-child(2) {
	font-family: 'GmarketSansTTFLight';
}

.FAQ td:last-child {
	cursor: pointer;
	font-family: 'GmarketSansTTFLight';
	width: 100px;
}

.FAQ td.toggle {
	text-align: right;
	padding-right: 10px;
	vertical-align: middle;
	font-size: 18px;
}

/* 펼치기, 접기 텍스트 스타일 */
.toggle-text {
	position: absolute;
	top: -20px;
	left: 50%;
	transform: translateX(-50%);
	font-size: 15px;
	color: gray;
	opacity:0;
	transition: opacity 0.2s;
}

/* 숨겨진 답변 스타일 */
.answer {
	display: none;
	color: #000;
	padding: 20px;
	background-color: #f9f9f9;
	border-bottom: 1px solid #ddd;
}
.answer td {
	padding-left: 250px;
}
#answer-font {
	color: #7ab863;
	font-family: 'GmarketSansTTFMedium';
}
</style>
</head>
<body>
   <header class="navbar">
      <a href="main.jsp">
      <img src="images/logo.png" alt="SuccuBuddy Logo" class="logo">
      </a>
      <nav class="nav-menu">
         <a href="sub1.jsp">다육 세트</a>
         <a href="sub2.jsp">다육 단품</a>
         <a href="sub3.jsp">맞춤 다육 추천</a>
         <a href="sub4.jsp">다육 탐구 생활</a>
         <a href="sub5.jsp">고객센터</a>
      </nav>
      <div class="nav-icons">
         <a href="mypage.jsp"><img src="images/Person.png" alt="사용자"></a>
         <a href="shopping_list.jsp"><img src="images/cart.png" alt="장바구니"></a>
         <a href="logout.jsp"><img src="images/logout.png" alt="로그아웃"></a> 
      </div>
   </header>


<div class="center-wrapper">
<div class="title">고객센터</div>

<div class="tab-menu">
  <div class="tab active" onclick="location.href='sub5.jsp'">자주묻는질문</div>
  <div class="tab" onclick="location.href='sub5-inquiry.jsp'">문의</div>
  <div class="tab" onclick="location.href='sub5-notice.jsp'">공지사항</div>
</div>

<div class="search">
  <input type="text" id="searchInput" placeholder="검색어를 입력하세요">
  <img src="images/Search.png" onclick="filterFAQ()">
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const toggles = document.querySelectorAll(".toggle");

    toggles.forEach((toggle, index) => {
      toggle.addEventListener("click", function() {
        const answer = this.parentElement.nextElementSibling;
        const toggleText = this.querySelector(".toggle-text");

        if (answer.style.display === "table-row") {
          answer.style.display = "none";
          this.textContent = "V";
          this.appendChild(toggleText); // 텍스트 유지
        } else {
          answer.style.display = "table-row";
          this.textContent = "▲";
          this.appendChild(toggleText); // 텍스트 유지
        }
      });
    });
  });
</script>

<table class="FAQ">
	<tr>
		<td>배송</td>
		<td>배송은 얼마나 걸리나요?</td>
		<td class="toggle">
		<span class="toggle-text"></span>V
		</td>
	</tr>
	<tr class="answer">
    <td colspan="3">배송은 보통 <span id="answer-font">2~3일</span> 소요됩니다.</td>
	</tr>

	<tr>
		<td>배송</td>
		<td>파손된 상품이 배송됐어요</td>
		<td class="toggle">
		<span class="toggle-text"></span>V
		</td>
	</tr>
	<tr class="answer">
    <td colspan="3">파손된 상품을 수령하셨다면 <span id="answer-font">고객센터</span>로 문의해 주세요.</td>
	</tr>

	<tr>
		<td>배송</td>
		<td>주문한 상품과 다른 상품이 왔어요</td>
		<td class="toggle">
		<span class="toggle-text"></span>V
		</td>
	</tr>
	<tr class="answer">
    <td colspan="3">주문하신 상품과 다른 상품이 도착한 경우,<br><span id="answer-font">상품 수령 후 7일 이내</span>에 고객센터로 문의해 주세요.</td>
	</tr>

	<tr>
		<td>주문/결제</td>
		<td>비회원으로 결제를 할 수 있나요?</td>
		<td class="toggle">
		<span class="toggle-text"></span>V
		</td>
	</tr>
	<tr class="answer">
    <td colspan="3">현재 비회원으로는 결제가 <span id="answer-font">불가능</span>합니다.<br>
	보다 원활한 주문 및 배송 조회를 위해 <span id="answer-font">회원가입 후 이용</span>해 주세요.</td>
	</tr>

	<tr>
		<td>주문/결제</td>
		<td>결제할 때 포인트를 일부만 사용할 수 있나요?</td>
		<td class="toggle">
		<span class="toggle-text"></span>V
		</td>
	</tr>
	<tr class="answer">
    <td colspan="3"><span id="answer-font">네, 가능합니다.</span><br>
	결제 단계에서 원하는 포인트 금액을 <span id="answer-font">직접 입력</span>하여 사용할 수 있습니다.</td>
	</tr>

	<tr>
		<td>취소/교환/환불</td>
		<td>상품이 파손되어서 배송왔는데 교환은 어떻게 하나요?</td>
		<td class="toggle">
		<span class="toggle-text"></span>V
		</td>
	</tr>
	<tr class="answer">
    <td colspan="3">상품이 파손된 경우, <span id="answer-font">수령 후 7일 이내</span>에 고객센터로 문의해 주세요.</td>
	</tr>

	<tr>
		<td>취소/교환/환불</td>
		<td>결제 취소는 어떻게 하나요?</td>
		<td class="toggle">
		<span class="toggle-text"></span>V
		</td>
	</tr>
	<tr class="answer">
    <td colspan="3">결제 취소는 아래 방법으로 가능합니다.<br>
	<span id="answer-font">● 카드 결제  </span>:결제 후 24시간 이내에 고객센터를 통해 요청시 바로 취소 가능<br>
	<span id="answer-font">● 무통장입금 </span>: 입금 전에는 취소 가능, 입금 후에는 환불 절차 필요<br>
	<span id="answer-font">● 포인트/쿠폰 사용 주문 </span>: 취소 후 자동으로 복구됨</td>
	</tr>

	<tr>
		<td>회원</td>
		<td>회원 탈퇴는 어떻게 하나요?</td>
		<td class="toggle">
		<span class="toggle-text"></span>V
		</td>
	</tr>
	<tr class="answer">
    <td colspan="3">회원 탈퇴는 아래 방법으로 가능합니다.<br>
	<span id="answer-font">마이페이지 > 회원정보 > 수정 > 회원탈퇴</span> 메뉴에서 직접 진행</td>
	</tr>
</table>
</div>
	<footer class="footer">
    <div class="footer-left">
        <span class="brand-name">succubuddy</span>
    </div>
    <div class="footer-right">
	<br>
        <span>주소 : 충청남도 천안시 서북구 성환읍 대학로 91 | EMAIL : succubuddy@naver.com</span>
        <span>TEL : 070-022-2026 | &copy; 2025 succubuddy. All Rights Reserved.</span>
		<br>
        <span><a href="#">개인정보처리방침</a> | <a href="#">이용약관</a></span>
    </div>
</footer>

<script>
function filterFAQ() {
  const input = document.getElementById("searchInput").value.toLowerCase();
  const rows = document.querySelectorAll(".FAQ tr");

  for (let i = 0; i < rows.length; i += 2) {
    const questionRow = rows[i];
    const answerRow = rows[i + 1];
    const category = questionRow.children[0].textContent.toLowerCase();
    const question = questionRow.children[1].textContent.toLowerCase();

    if (category.includes(input) || question.includes(input)) {
      questionRow.style.display = "";
      answerRow.style.display = "none";
    } else {
      questionRow.style.display = "none";
      answerRow.style.display = "none";
    }
  }
}

// 엔터키 처리 + 실시간 필터링
document.addEventListener("DOMContentLoaded", function () {
  const searchInput = document.getElementById("searchInput");

  searchInput.addEventListener("keyup", function (e) {
    filterFAQ(); // 입력 바뀔 때마다 즉시 필터링

    if (e.key === "Enter") {
      e.preventDefault(); // 폼 제출 방지 (있을 경우)
      filterFAQ();        // 엔터 시도 동일하게 처리
    }
  });
});
</script>


</body>
</html>