<!DOCTYPE html>
<html lang="ko">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=euc-kr">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Main</title>
    <style>
        @font-face {
            font-family: 'GmarketSansTTFMedium';
            src: url('fonts/GmarketSansTTFMedium.ttf') format('truetype');
        }
        
        @font-face {
            font-family: 'GmarketSansTTFBold';
            src: url('fonts/GmarketSansTTFBold.ttf') format('truetype');
        }
        
        @font-face {
            font-family: 'GmarketSansTTFLight';
            src: url('fonts/GmarketSansTTFLight.ttf') format('truetype');
        }
		@font-face {
			font-family: 'RixInooAriDuriPro';  /* 폰트 이름 지정 */
			src: url('fonts/RixInooAriDuri_Pro Regular.otf')  format('opentype'); /* OTF 파일은 'opentype' 지정 */
			font-weight: normal;
			font-style: normal;
		}
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            width: 1920px;
            max-width: 100%; /* 화면 크기에 맞춰 자동 조정 */
            overflow-x: hidden;
        }

		   .navbar {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 82px 150px;
			width: 1920px;
			margin: 0 auto;
			margin-bottom: 20px; /* 네비게이션 아래 여백 추가 */
		}

		.logo {
			display: block;
			width: 300px;
			height: 56px;
			margin-left: -30px;
			margin-right: 20px;
		}

		.nav-menu {
			display: flex;
			align-items: center;
			gap: 80px;
		}

		.nav-menu a {
			text-decoration: none;
			color: black;
			font-size: 26px;
			font-weight: 550;
			font-family: 'GmarketSansTTFMedium';
			margin-top: 12px;
		}

		.nav-icons {
			display: flex;
			align-items: center;
			gap: 35px; /* 아이콘 및 로그인 간격 */
			margin-top: 10px; /* 아이콘과 로그인 위치 조정 */
			margin-left: 33px;
		}

		/* 아이콘 크기 조정 */
		.nav-icons img {
			width: 40px;
			height: 40px;
		}

		/* 로그아웃 링크 스타일 */
		.nav-login {
			text-decoration: none;
			font-size: 24px;
			font-family: 'GmarketSansTTFMedium';
			color: black;
			margin-top:10px;
		}

		.container {
			width: 1800px;
			margin: 60px auto;
			padding-top: 50px;
		}

        .banner {
			width: 1759px;
			height: 740px;
			margin-bottom: 170px;
			position: relative;
			margin-top: -100px;
			margin-left: 25px;
			
			background-image: url('images/keyimg.jpg');
			background-size: cover;
			background-position: center;
			background-repeat: no-repeat;
        }
		.content {
			text-align: center;
		}

		h1 {
			font-size: 34px;
			margin-bottom: 45px;
			margin-left: -50px;
			font-family: 'GmarketSansTTFMedium';
		}

		.highlight {
			color: #4CAF50; /* 초록색 강조 */
		}

		.description {
			font-size: 24px;
			line-height: 1.6;
			color: #000000;
			margin-bottom: 40px;
			margin-left: -50px;
			font-family: 'GmarketSansTTFLight';
		}

		.call-to-action {
			font-size: 24px;
			color: #000000;
			font-family: 'GmarketSansTTFLight';
			margin-bottom: 250px;
			margin-left: -50px;
		}

		/*식물 카테고리*/
		.plant-container {
			width: 1500px;
			height: 900px;
			position: relative;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			box-sizing: border-box;
			background-image: url('images/typeofsuccu.png');
			background-repeat: no-repeat;
			padding: 50px;
			display: flex;
			flex-direction: column;
			gap: 50px;
			margin-top: 650px;
			margin-bottom: -400px;
			margin-right: -100px;
			
		}

		.plant-category-container {
			display: flex;
			justify-content: center; /* 카테고리 중앙 정렬 */
			align-items: center;      /* 세로 중앙 정렬 */
			width: 100%;
			position: relative;
			top: -110px; /* 카테고리를 선과 함께 위로 이동 */
		}

		.plant-category-wrapper {
			display: flex;
			gap: 30px;
			justify-content: center;
			background-color: #fff; /* 선을 가리는 흰색 배경 */
			z-index: 2; /* 선 위로 배치 */
			padding: 0 35px;
			position: relative;
			top: -5px; /* 카테고리와 선의 시각적 정렬 최적화 */
			width: fit-content; /* 카테고리만큼만 너비 설정 */
		}
		.plant-category-wrapper::before,
		.plant-category-wrapper::after {
			content: "";
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			width: 20px;  /* 가림막의 너비 */
			height: 4px;  /* 가림막의 높이 (선과 일치) */
			background-color: #fff; /* 배경과 동일한 색으로 선 가림 */
			z-index: 3;
		}

		.plant-category-wrapper::before {
			left: -15px;  /* 왼쪽 끝 선 가림 */
		}

		.plant-category-wrapper::after {
			right: -10px; /* 오른쪽 끝 선 가림 */
		}
        .plant-category {
            text-align: center;
            color: #60af46;
            cursor: pointer; /* 선택 가능한 형태로 변경 */
        }

        .plant-circle {
            width: 126px;
            height: 126px;
            border-radius: 50%;
            background-color: transparent; /* 선택 전에는 원 없음 */
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 5px;
            transition: background-color 0.3s ease, color 0.3s ease, transform 0.3s ease;
            position: relative;
        }

        .plant-circle img {
            width: 50px;  /* 기본 이미지 크기 */
            height: 50px;
            transition: filter 0.3s ease, width 0.3s ease, height 0.3s ease;
        }

        .plant-circle .plant-text {
            position: absolute;
            bottom: -10px;
            width: 100%;
            font-size: 24px;  /* 기본 글씨 크기 */
            transition: font-size 0.3s ease;
			font-family: 'GmarketSansTTFMedium';
        }

        .plant-selected .plant-circle {
            background-color: #60af46;  /* 선택 시 초록색 원 */
            color: #fff;               /* 선택 시 글씨 흰색 */
            flex-direction: column;    /* 글씨와 이미지가 한 줄에 표시 */
            width: 126px;               /* 선택 시 원 크기 커짐 */
            height: 126px;
        }

        .plant-selected .plant-text {
            position: static;
            color: #fff;               /* 선택 시 글씨 흰색 */
            font-size: 24px;           /* 선택 시 글씨 크기 증가 */
			font-family: 'GmarketSansTTFMedium';
        }

        .plant-selected .plant-circle img {
            width: 50px;  /* 선택 시 이미지 크기 증가 */
            height: 50px;
			margin-bottom: 15px;
            filter: brightness(0) invert(1);  /* 선택 시 이미지 흰색 처리 */
        }
		 .plant-info {
            width: 100%;
            display: flex;
            justify-content: space-between;
        }

        .plant-details {
            width: 65%;
        }
		.plant-content {
			display: flex;
			align-items: center; /* 세로 중앙 정렬 */
			width: 100%;
			position: relative;
		}

		/* 정보 전체 */
		#plant-info-content {
			width: 60%;
			padding-right: 50px;
			margin-top: -80px;
		}
		/* 왼쪽 (정보)*/
		.plant-overview {
			font-family: 'GmarketSansTTFBold';  /* 강조된 글씨체 */
			font-size: 20px;                    /* 기존 스타일에 맞춘 크기 */
			color: #f4a900;                        /* 검은색 글씨 */
			margin-bottom: 40px;                /* 설명과 구조적 특징 사이 여백 추가 */
			line-height: 1.8;                   /* 줄 간격 조정 */
			margin-left: 50px;
			width:650px;
			height: 90px;
			padding-top: 10px;
		}
		#plant-info-content p {
			color: #60af46;
		    font-family: 'GmarketSansTTFMedium';
			margin-bottom: 20px;
			margin-top: 20px;
			margin-left: 50px;
			font-size: 26px;
		}

		#plant-info-content ul {
			margin-top: 10px;
			margin-bottom: 41px;
			padding-left: 20spx;
			line-height: 1.8;
			list-style: disc;
			margin-left: 65px;
			font-size: 20.5px;
			font-family: 'GmarketSansTTFLight';
		}

		/* 오른쪽 (이미지) */
		#plant-image-content {
			width: 43%;
			display: flex;
			flex-wrap: wrap;
			gap: 23px;
			margin-top: -85px;
		}

		#plant-image-content img {
			width: 122px;
			height: auto;
		}
		.plant-item {
			display: flex;
			flex-direction: column;
			align-items: center;   /* 이미지 + 이름 가운데 정렬 */
			width: 122px;          /* 기존 이미지 크기에 맞게 설정 */
			margin-top: -10px;
		}

		.plant-item p {
			margin-top: 9px;       /* 이미지와 이름 사이 여백 */
			font-size: 18px;       /* 글씨 크기 */
			color: #000000;       /* 초록색 강조 */
			font-family: 'GmarketSansTTFLight';
			text-align: center;    /* 텍스트 중앙 정렬 */
		}
		/* [조건부 스타일] 이미지가 3개 이하일 경우 */
		.center-layout {
			width: 100%;                /* 전체 너비 사용 */
			
		}

		.center-layout .plant-item img {
			width: 122px;              /* 크기를 키워 균형 맞춤 */
			height: 122px;
			margin-top: -265px;
		}

		.center-layout .plant-item {
			width: 110px;               /* 박스 크기 키우기 */
		}
		
		/* 섹션 타이틀 */
		.section-title {
		    font-family: 'RixInooAriDuriPro';
			font-size: 40px;
			color: #000000;
			text-align: left;
			margin-bottom: 10px;
			margin-top: 150px;
			padding-bottom: 5px;
			margin-left: 70px;
		}
		/*RECOMMEND sccu*/
		.rm-wrapper {
			max-width: 1920px;                 /* 최대 1920px까지만 */
			height: 904px;                     /* 세로 고정 */
			background-image: url('images/rmbackground.png');
			background-repeat: no-repeat;
			background-position: center center;
			background-size: 100% 904px;       /* 가로는 100%, 세로는 고정 */
			position: relative;
			margin: 0 auto;
			display: flex;
			justify-content: center;
			align-items: center;
			overflow: hidden;
			padding: 0;
			border: none;
			margin-left: -50px;
			margin-right: -100px;
			margin-top: 71px;
			margin-bottom: 123px;
		}


        .rm-slide-container {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 1400px;
			margin: 0 auto;
        }

        .rm-arrow {
            width: 100px;
            height: 120px;
            cursor: pointer;
        }

        .rm-slide-content {
            display: flex;
            gap: 80px;
            align-items: center;
            justify-content: center;
			margin-top: 100px;
        }

        .rm-left {
            text-align: center;
        }

        .rm-plant-image {
            width: 400px;
            height: 400px;
        }

        .rm-plant-name {
            color: #60af46;
            font-size: 35px;
            margin-top: 32px;
			font-family: 'GmarketSansTTFBold';
        }

        .rm-more-link {
            font-size: 18px;
            color: #000000;
			margin-top: 15px;
			margin-left: 145px;
			font-family: 'GmarketSansTTFLight';
        }

       .rm-right {
			padding: 30px;
			width: 830px;
			margin-right: 30px;
		}

		.rm-description {
			text-align: center;
			font-size: 24px;
			color: #000000;
			margin-bottom: 60px;
			font-family: 'GmarketSansTTFLight';  
		}
		#rec-description {
		  white-space: pre-line;
		  white-space: nowrap;
		  line-height: 1.6;
		  text-align: center;
		}
		.rm-info-table {
			display: grid;
			grid-template-columns: 1fr 1fr;
		}

		.rm-info-item {
			display: flex;
			flex-direction: column; /* 수직 정렬 */
			align-items: flex-start;
			gap: 20px;
			padding: 20px;
			box-sizing: border-box;
			min-height: 120px;
		}

		/* 십자선만 보이게 조건부 테두리 설정 */
		.rm-info-item:nth-child(1),
		.rm-info-item:nth-child(2) {
			border-bottom: 2px solid #9ED88F;
		}
		.rm-info-item:nth-child(1),
		.rm-info-item:nth-child(3) {
			border-right: 2px solid #9ED88F;
		}

		.rm-info-icon {
			width: auto;
			height: auto;
			margin-top: 4px;
		}
		.rm-info-text {
			display: flex;
			flex-direction: column;
		}

		.rm-info-title {
			font-size: 20px;
			font-family: 'GmarketSansTTFMedium';
			color: #111;
		}

		.rm-info-detail {
			font-size: 18px;
			font-family: 'GmarketSansTTFLight';
			color: #666;
			margin-top: 10px;
		}
		.succu-difficulty-btn {
			position: absolute;
			top: 135px;
			left: 60%;
			transform: translateX(-50%);
			width: 341px;
			height: 86px;
			display: inline-flex;
			align-items: center;
			border: 2px solid #6EB466;
			border-radius: 43px;
			padding: 8px 18px;
			
			font-family: 'GmarketSansTTFBold';
			font-size: 34px;
			color: #6EB466;
			z-index: 10;
		}

		.succu-text {
			margin-right: 6px;
			margin-left: 45px;
		}

		.succu-star {
			width: 30px;
			height: 29px;
			vertical-align: middle;
			margin-top: -5px;
			margin-left: 10px;
		}
		/* month of succu*/
		.month-wrapper {
			display: flex;
			justify-content: space-between;
			padding: 60px 100px;
			position: relative;
		}
		.month-card-topdotted-img {
			width: 1633px; /* 또는 60% 등 적절히 조절 */
			height: 10px; /* 점선 이미지 높이 */
			background-image: url('images/dashline.png');
			background-repeat: repeat-x;
			background-position: center;
			background-size: contain; /* or cover */
			margin: 120px auto;
			margin-bottom: -120px;

		}
		.month-card-bottomdotted-img {
			width: 1633px; /* 또는 60% 등 적절히 조절 */
			height: 10px; /* 점선 이미지 높이 */
			background-image: url('images/dashline.png');
			background-repeat: repeat-x;
			background-position: center;
			background-size: contain; /* or cover */
			margin: 10px auto;
			margin-top: -200px;
		}

		.month-left {
			display: flex;
			align-items: center; /* 수직 가운데 정렬 */
			height: 840px; /* 오른쪽 카드와 동일하게 맞추기 */
			margin-left: 30px;
		}

		.month-left-content {
			width: 100%;
			margin-top: 30px;
		}

		.month-left-title {
			font-size: 35px;
			margin-bottom: 15px;
			font-family: 'GmarketSansTTFMedium';
			margin-top: 40px;
		}
		.month-left-subtitle {
			font-size: 30px;
			margin-bottom: 63px;
			margin-top: 78px;
			text-align: center;
			font-family: 'GmarketSansTTFMedium';
			position: relative;
			display: inline-block;
		}
		.month-left-subtitle::after {
			content: '';
			position: absolute;
			bottom: -6px;
			left: 0;
			margin-left: 10px;
			width: 100%;
			height: 2px;
			background-color: #f4a900;
		}

		.month-left-subtitle::before {
			content: '';
			position: absolute;
			bottom: -11px;
			left: 0;
			margin-left: 30px;
			width: 100%;
			height: 2px;
			margin-right: -20px;
			background-color: #f4a900;
		}
		.month-left-subtitle img {
			vertical-align: middle;
			width: 30px;
			height: 30px;
			margin-right: 10px;
			margin-top: -35px;
		}

		.month-left-guide {
			list-style: none;
			padding: 0;
			margin: 0;
			margin-top: 60px;
		}
		.month-left-guide li {
			display: flex;
			align-items: center; /* 세로 가운데 정렬 */
			gap: 20px;
			margin-bottom: 50px;
			font-size: 24px;
			color: #444;
			line-height: 1.4;
			font-family: 'GmarketSansTTFLight';
		}

		.month-left-guide img {
			width: auto;
			height: 35px;
			flex-shrink: 0; /* 이미지 크기 유지 */
			margin-top: 0;  /* 정렬 깨짐 방지 */
		}

		.month-guide-text {
			display: inline-block;
		}

		/* 제목용 하이라이트 (예: "5월의 다육") */
		.month-highlight-title {
			color: #f4a900;
			font-size: 50px;
			font-family: 'GmarketSansTTFBold';
		}

		/* 설명 문장 중 강조 텍스트용 (예: "강한 직사광선" 등) */
		.month-highlight-desc {
			color: #60af46;
			font-size: 24px;
			font-family: 'GmarketSansTTFMedium';
		}

		/*right*/
		.month-right-card {
			position: relative; /* 기준점 */
			width: 621px;
			height: 845px;
			background-color: #f0f7ec;
			border-radius: 30px;
			transform: rotate(6deg);
			margin: 8px 22px;
			margin-bottom: 50px;
			padding-top: 50px;
		}

		.month-card {
			background-color: #eef6ea;
			border-radius: 20px;
			padding: 100px 80px;
			text-align: center;
			width: 100%;
			height: 100%;
			box-sizing: border-box;
			position: relative;
		}
				
		.month-top-title {
			  font-size: 35px;
			  color: #4CAF50; /* 초록색 */
			  text-align: center;
			  font-family: 'GmarketSansTTFBold';
		}
		.month-card-imgbox {
			background-color: white;
			padding: 15px;
			border-radius: 12px;
			margin: 80 auto 20px;
			width: 451.46px;
			height: 300px;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.month-card-img {
			max-width: 100%;
			max-height: 100%;
		}
		.month-card-name {
			font-size: 35px;
			margin: 45px 0;
			font-family: 'GmarketSansTTFMedium';
		}

		.month-card-line {
			width: 80%;
			height: 1px;
			background: #000000;
			margin: 50px auto 18px;
		}

		.month-card-desc {
			font-size: 22px;
			color: #333;
			font-family: 'GmarketSansTTFLight';
			line-height: 1.7;
			word-break: keep-all;       /* 단어 중간 줄바꿈 방지 */
			white-space: normal;        /* 자동 줄바꿈 허용 */
			padding: 0 0px;            /* 좌우 여백 */
			text-align: center;
			display: block;
			max-width: 100%;             /* 카드 안쪽 최대 폭 */
			margin: 50px auto;             /* 가운데 정렬 */
			white-space: nowrap;        /* 줄바꿈 방지 */
		}

		/* 테이프 */
		.month-tape {
			width: 230px;
			height: 53px;
			background-color: #81c784;
			position: absolute;
			z-index: 2;
			opacity: 0.85;
		}

		/* 좌측 상단 테이프 */
		.tape-top-left {
			top: 125px;
			left: -50px;
			transform: rotate(-45deg);
			transform-origin: left top;
		}

		/* 우측 하단 테이프 */
		.tape-bottom-right {
			bottom: 90px;
			right: -50px;
			transform: rotate(-45deg);
			transform-origin: right bottom;
		}

		/* CUSTOM SUCCU */
		.custom-wrapper {
		  display: flex;
		  justify-content: space-between;
		  max-width: 1400px; /* 줄였어 */
		  margin: 100px auto;
		  padding: 0 20px; /* 여백도 줄였어 */
		  box-sizing: border-box;
		}

		/* 왼쪽 텍스트 영역 */
		.custom-left {
		  width: 38%;
		  text-align: center;
		  margin-top: 60px;
		}

		.custom-left-text {
		  font-size: 33px;
		  margin-bottom: 10px;
		  white-space: nowrap;        /* 줄바꿈 방지 */
		  font-family: 'GmarketSansTTFMedium';
		  line-height: 1.6;
		}

		.custom-highlight-title {
		  color: #4CAF50;
		  font-family: 'GmarketSansTTFBold';
		}

		.custom-highlight-desc {
		  color: #60af46;
		  font-family: 'GmarketSansTTFMedium';
		}

		.custom-left p {
		  font-size: 30px;
		  color: #555;
		  margin-bottom: 30px;
		  font-family: 'GmarketSansTTFLight';
		}

		.custom-test-button {
		  display: inline-block;
		  background-image: url('images/hawor.png'); /* 실제 이미지 경로로 수정 */
		  background-size: cover;
		  background-repeat: no-repeat;
		  background-position: center;
		  width: 500px;   /* 이미지 크기 맞게 조정 */
		  height: 472px;
		  text-align: center;
		  line-height: 200px;
		  margin-top: 50px;
		  text-decoration: none;
		  font-family: 'GmarketSansTTFBold';
		  font-size: 34px;
		  padding-top: 130px;
		  color: #4CAF50;
		  transition: transform 0.2s ease;
		}

		.custom-test-button:hover {
		  transform: scale(1.05);
		}


		/* 오른쪽 이미지 영역 */
		.custom-right {
		  width: 50%;
		  margin-bottom: 100px;
		  position: relative;
		}

		/* 오른쪽 전체 이미지 */
		.custom-full-image {
		  max-width: 100%;
		  height: auto;
		  display: block;
		  
		}

		/*푸터*/
       .footer {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 1920px;
            height: 283px;
            padding: 0 150px; /* 왼쪽과 오른쪽 패딩 조정 */
            background-color: #60af46;
        }

        .footer-left,
        .footer-right {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .footer-left {
            font-size: 50px;
            font-family: 'RixInooAriDuriPro'; /* Medium font 적용 */
            margin-left: 50px;
			color: #ffffff;
        }

        .footer-right {
            font-size: 18px;
            color: #ffffff;
            margin-left: 130px;
            font-family: 'GmarketSansTTFLight'; /* Light font 적용 */
        }

        .footer-right span {
            margin-bottom: 10px;
        }

        .footer-right a {
            text-decoration: none;
            color: #ffffff;
        }
       
    </style>
</head>
<!--plant-category-->
<script>
    const plantData = {
        "Crassulaceae": {
            overview: `
                <div class="plant-overview">
                    주로 잎이 두껍고 로제트 형태를 이루고, 번식이 쉬운 것이 특징이며<br>
                    온대 및 열대 지역에서 주로 서식하고, 실내에서 키우기 좋은 식물
                </div>
            `,
            description: `
                <p>구조적 특징</p>
                <ul>
                    <li>잎이 두껍고 통통하여 수분 저장 능력이 뛰어나 가뭄에 강하다</li>
                    <li>로제트 형태(장미 모양 잎 배열)가 많고 로라, 제옥 등이 대표적이다</li>
                    <li>줄기가 짧거나 거의 없으며 긴 줄기 형태로 자라기도 한다</li>
                </ul>
                <p>생장 및 번식</p>
                <ul>
                    <li>잎꽂이, 줄기꽂이로 번식이 쉽고 잎 하나만 떨어져도 뿌리를 내릴 수 있다</li>
                    <li>햇빛이 충분해야 건강하게 자랄 수 있으며 햇빛 부족하면 웃자림 발생한다</li>
                </ul>
            `,
             images: [
            { src: "images/l001.png", name: "염자" },
			{ src: "images/m002.png", name: "청하각금" },
			{ src: "images/m003.png", name: "백운각" },	
			{ src: "images/m004.png", name: "백망룡" },
			{ src: "images/m005.png", name: "구름새 철화" },
			{ src: "images/m006.png", name: "청하각" },
			{ src: "images/s002.png", name: "로라" },
			{ src: "images/s003.png", name: "제옥" },   
			{ src: "images/s004.png", name: "브론즈" },
			{ src: "images/s005.png", name: "성미인" },   
			{ src: "images/s006.png", name: "블루빈스" },
			{ src: "images/s007.png", name: "부다템플" },
			{ src: "images/s008.png", name: "녹귀란" }  
            ]
        },
		"Cactaceae": {
            overview: `
                <div class="plant-overview">
                    잎이 가시로 변형되어 있고, 두꺼운 줄기에 물을 저장하는 것이 특징이며<br>
                    주로 건조한 사막 지역에서 자라고, 가뭄에 매우 강한 특성을 가진 식물
                </div>
            `,
            description: `
                <p>구조적 특징</p>
                <ul>
                    <li>잎 대신 가시를 가지고 있어 수분 증발을 막고, 동물의 접근을 차단한다</li>
                    <li>두꺼운 줄기 속에 수분 저장해서 건조한 환경에서도 생존 가능하다</li>
                    <li>왁스층이 발달해서 수분 손실을 막기 위한 보호막 형성한다</li>
                    <li>줄기가 광합성을 담당해서 잎이 없어도 스스로 영양을 생성할 수 있다</li>
                </ul>
                <p>생장 및 번식</p>
                <ul>
                    <li>성장 속도가 느려서 대부분의 선인장은 수십 년까지도 자란다</li>
                    <li>삽목이나 자구(새끼 선인장)로 번식 가능하다</li>
                </ul>
            `,
            images: [
                { src: "images/l007.png", name: "율리치아나" },
            ]
        },
		"Asphodelaceae": {
            overview: `
                <div class="plant-overview">
                    대체로 로제트 형태를 띠고 있고, 선인장과 달리 잎이 있으며<br>
                    다육식물 중에서도 공기 정화 능력이 뛰어난 종류가 많은 식물
                </div>
            `,
            description: `
                <p>구조적 특징</p>
                <ul>
                    <li>잎이 가늘고 길며 끝이 뾰족한 경우가 많다</li>
                    <li>일부 종은 줄기가 없이 땅에서 바로 잎이 퍼진다</li>
                    <li>반그늘에서도 잘 자란다</li>
                </ul>
                <p>생장 및 번식</p>
                <ul>
                    <li>잎꽂이나 줄기꽂이로 번식 가능하다</li>
                    <li>햇빛이 부족해도 비교적 잘 견딘다</li>
                </ul>
            `,
            images: [
				{ src: "images/l002.png", name: "스투키" },
				{ src: "images/l004.png", name: "알로에" },
				{ src: "images/l005.png", name: "문샤인" },
				{ src: "images/s001.png", name: "하월시아<br>옵투사" }
            ]
        },
		"Euphorbiaceae": {
            overview: `
                <div class="plant-overview">
                    선인장과 헷갈리지만, 가시의 구조와 유액(흰색 수액)으로 구별되며<br>
                     주로 열대 지방에서 서식하고, 가뭄에 강한 식물
                </div>
            `,
            description: `
                <p>구조적 특징</p>
                <ul>
                    <li>줄기에서 흰색 유액(수액)이 나오는데 독성이 있는 경우가 많아 주의 필요하다</li>
                    <li>선인장과 비슷한 외형이지만 가시 구조가 다르다</li>
                    <li>작고 눈에 띄지 않는 꽃을 피운다</li>
                </ul>
                <p>생장 및 번식</p>
                <ul>
                    <li>삽목으로 쉽게 번식 가능하다</li>
                    <li>햇빛이 많을수록 튼튼하게 자란다</li>
                </ul>
            `,
            images: [
			    { src: "images/l003.png", name: "연필선인장" },
                { src: "images/m007.png", name: "용신목" },
				{ src: "images/m008.png", name: "은세무리아" }
            ]
        },
		"Agavaceae": {
            overview: `
                <div class="plant-overview">
                     긴 칼 모양의 잎과 날카로운 가시를 가지며 건조한 환경에<br>
                     강한 식물로 생애 한 번 꽃을 피우는 경우가 많음
                </div>
            `,
            description: `
                <p>구조적 특징</p>
                <ul>
                    <li>잎이 길고 뾰족하며, 중앙에서 바깥으로 뻗음</li>
                    <li> 잎가장자리에 가시가 있는 종이 많음 → 천연 방어 기제</li>
                    <li>일부 종은 생애 한 번만 꽃을 피우고 죽음 (단명식물)</li>
                </ul>
                <p>생장 및 번식</p>
                <ul>
                    <li>번식 속도가 느린 편 → 하지만 일부는 자구를 만들어 번식 가능</li>
                    <li>햇빛을 많이 받아야 건강하게 자람</li>
                </ul>
            `,
            images: [
                { src: "images/m001.png", name: "아가베<br>아테누아타" }
            ]
        }
    };
	
       // 첫 화면에서 돌나물 기본 표시 (중요!)
    window.onload = function() {
        const defaultCategory = document.querySelector('.plant-category[data-category="Crassulaceae"]');
        if (defaultCategory) {
            selectCategory(defaultCategory);  // 첫 화면에 돌나물 표시
        }
    };

      function selectCategory(element) {
        const categories = document.querySelectorAll('.plant-category');
        categories.forEach(cat => cat.classList.remove('plant-selected'));

        element.classList.add('plant-selected');

        const category = element.getAttribute('data-category');
        const plantInfo = plantData[category];

        const infoContent = document.getElementById('plant-info-content');
        const imageContent = document.getElementById('plant-image-content');

        // 이미지 개수에 따라 레이아웃 결정
        if (plantInfo.images.length <= 4) {
            document.querySelector('.plant-info').classList.add('center-layout');  
        } else {
            document.querySelector('.plant-info').classList.remove('center-layout');  
        }

        // **설명 추가 (overview + description)**
        infoContent.innerHTML = (plantInfo.overview || '') + plantInfo.description;

        imageContent.innerHTML = 
            plantInfo.images.map(img => `
                <div class="plant-item">
                    <img src="${img.src}" alt="${img.name}">
                    <p class="plant-name">${img.name}</p>
                </div>
            `).join('');
    }
	
</script>
<!--RECOMMEND succu-->
<script>
    let currentSlide = 0;

    const products = [
        {
            name: "하월시아옵투사",
            description: "특별한 관리하지 않아도 잎이 통통해서 물을 머금고 있기 때문에 많은 물을 \n 필요로 하지 않아서 초보자도 쉽게 키울 수 있습니다.",
            image: "images/s0001.png",
            care: [
                { icon: "images/g_water.png", text: "평균 월 1~2회", desc: "통통한 잎이 살짝 쭈글해지면 듬뿍" },
                { icon: "images/g_thermometer.png", text: "잘 자라는 온도", desc: "16~20°C" },
                { icon: "images/g_sun.png", text: "반양지", desc: "하루 2~3시간 정도의 은은한 햇빛" },
                { icon: "images/g_cloud.png", text: "40~70%", desc: "주변 공기가 너무 축축하지 않게 관리" }
            ]
        },
        {
            name: "청하각",
            description: "강한 햇빛에도 잘 견디며,잎 끝이 붉게 물들어 보기 좋고 많은 물 없이도 \n 잘 자라서 초보자도 쉽게 키울 수 있는 식물입니다.",
            image: "images/m0006.png",
            care: [
                { icon: "images/g_water.png", text: "평균 월 1회 이하", desc: "단단한 몸통이 쭈글해지면 듬뿍" },
                { icon: "images/g_thermometer.png", text: "잘 자라는 온도", desc: "15~30℃" },
                { icon: "images/g_sun.png", text: "양지", desc: "하루 6시간 이상 밝은 햇빛" },
                { icon: "images/g_cloud.png", text: "40% 이하", desc: "주변 공기를 건조하게 관리" }
            ]
        },
        {
            name: "문샤인",
            description: "은은한 햇빛에도 잘 적응하며, 두꺼운 잎에 수분을 저장해 물을\n자주 주지 않아도 되어 초보자도 쉽게 키울 수 있는 식물입니다.",
            image: "images/l0005.png",
            care: [
                { icon: "images/g_water.png", text: "평균 월 1회 이하", desc: "빳빳한 잎이 조글쪼글해지면 주세요" },
                { icon: "images/g_thermometer.png", text: "잘 자라는 온도", desc: "21~25℃" },
                { icon: "images/g_sun.png", text: "반양지", desc: "하루 2~3시간 정도의 은은한 햇빛" },
                { icon: "images/g_cloud.png", text: "40~70%", desc: "주변 공기가 너무 축축하지 않게 관리" }
            ]
        }
    ];

   function updateSlide() {
		const product = products[currentSlide];

		// 강조 처리 함수
		let desc = product.description
			.replace(/특별한 관리하지 않아도/g, "<span style='color:#f4a900; font-family:GmarketSansTTFMedium;'>특별한 관리하지 않아도</span>")
			.replace(/초보자도 쉽게/g, "<span style='color:#f4a900; font-family:GmarketSansTTFMedium;'>초보자도 쉽게</span>")
			.replace(/강한 햇빛에도 잘 견디며/g, "<span style='color:#f4a900; font-family:GmarketSansTTFMedium;'>강한 햇빛에도 잘 견디며</span>")
			.replace(/은은한 햇빛에도 잘 적응하며/g, "<span style='color:#f4a900; font-family:GmarketSansTTFMedium;'>은은한 햇빛에도 잘 적응하며</span>")

			.replace(/\n/g, "<br>"); // 줄바꿈 처리

		document.getElementById('rec-name').textContent = product.name;
		document.getElementById('rec-description').innerHTML = desc;
		document.getElementById('rec-img').src = product.image;

		const careItems = document.querySelectorAll('.rm-info-item');
		product.care.forEach((item, index) => {
			const infoIcon = careItems[index].querySelector('img');
			const infoTitle = careItems[index].querySelector('.rm-info-title');
			const infoDetail = careItems[index].querySelector('.rm-info-detail');

			infoIcon.src = item.icon;
			infoTitle.textContent = item.text;
			infoDetail.textContent = item.desc;
		});
	}


    function prevSlide() {
        currentSlide = (currentSlide === 0) ? products.length - 1 : currentSlide - 1;
        updateSlide();
    }

    function nextSlide() {
        currentSlide = (currentSlide === products.length - 1) ? 0 : currentSlide + 1;
        updateSlide();
    }

    window.addEventListener('load', updateSlide);
</script>
<!--MONTH OF SUCCU-->
<script>
  const monthProducts = [
    {
      productId: "m006",
      name: "청하각",
      description: "잎이 단단하고 물이 많아 기온 변화에 강한 편\n햇빛을 충분히 주면 색이 선명해지고 건강하게 자람"
    },
    {
      productId: "s003",
      name: "제옥",
      description: "봄철(5월)에 성장이 활발해 잎꽂이 번식\n 통풍이 잘되는 환경에서 키우면 병해를 예방 가능"
    },
    {
      productId: "s005",
      name: "성미인",
      description: "줄기가 길게 늘어지는 형태로 예쁜 모습\n초보자도 쉽게 키울 수 있어 관리하기 편함"
    },
    {
      productId: "s008",
      name: "녹귀란",
      description: "5월부터 성장 빨라지면서 햇빛과 수분 관리가 중요함\n통풍이 좋으면 잎이 단단해지고 병해도 줄어듦"
    }
  ];

  let currentMonth = 0;

	 function updateMonthSlide() {
	  const data = monthProducts[currentMonth];

	  // 줄바꿈 및 강조 텍스트 처리
	  let desc = data.description
		.replace(/\\n/g, "<br>") // \n이 문자 그대로 있을 경우 처리
		.replace(/\n/g, "<br>")  // 실제 줄바꿈도 처리
		.replace(/잎꽂이 번식/g, "<span style='color:#f4a900; font-family:GmarketSansTTFBold;'>잎꽂이 번식</span>")
		.replace(/자주 환기/g, "<span style='color:#f4a900; font-family:GmarketSansTTFBold;'>자주 환기</span>")
		.replace(/성장 빨라지면서/g, "<span style='color:#f4a900; font-family:GmarketSansTTFBold;'>큰 일교차에 주의</span>")
		.replace(/큰 일교차에 주의/g, "<span style='color:#f4a900; font-family:GmarketSansTTFBold;'>수분 관리가 중요함</span>")
		.replace(/초보자도 쉽게/g, "<span style='color:#f4a900; font-family:GmarketSansTTFBold;'>초보자도 쉽게</span>")
		.replace(/잎이 단단하고 물이 많아/g, "<span style='color:#f4a900; font-family:GmarketSansTTFBold;'>잎이 단단하고 물이 많아</span>")
		.replace(/색이 선명해지고/g, "<span style='color:#f4a900; font-family:GmarketSansTTFBold;'>색이 선명해지고</span>")
		.replace(/병해도 줄어듦/g, "<span style='color:#f4a900; font-family:GmarketSansTTFBold;'>병해도 줄어듦</span>")
		.replace(/수분 관리가 중요함/g, "<span style='color:#f4a900; font-family:GmarketSansTTFBold;'>수분 관리가 중요함</span>");

	  document.querySelector(".month-card-img").src = "images/" + data.productId + ".png";
	  document.querySelector(".month-card-name").textContent = data.name;
	  document.querySelector(".month-card-desc").innerHTML = desc;
	}


  window.addEventListener("load", () => {
    updateMonthSlide();
    setInterval(() => {
      currentMonth = (currentMonth + 1) % monthProducts.length;
      updateMonthSlide();
    }, 5000); // 5초마다 전환
  });
</script>

<script>
	function goToSub3() {
		window.location.href = "sub3.jsp";  // 이동할 페이지 경로 설정
	}
</script>
<body>
   <header class="navbar">
